	end
	if type(table1.eiFlags) == "table" then
		table1.eikey = string.lower(tostring(espType or ""))
		if table1.eikey == "box2d" or table1.eikey == "2dbox" then return table1.eiFlags.box2d == true end
		if table1.eikey == "box3d" or table1.eikey == "3dbox" then return table1.eiFlags.box3d == true end
