end
table1.getrandomsong = function(mode)
	local list = table1.songlist()
	if #list == 0 then return nil end

	if mode == "avoidlast" then
		if #list == 1 then return list[1] end
		local choice
		repeat
			choice = list[math.random(1, #list)]
		until choice ~= table1.lastSong
		table1.lastSong = choice
		return choice
	end

	if mode == "avoidallplayed" then
		local available = {}
		for _, name in ipairs(list) do
			if not table1.playedSongs[name] then
				table.insert(available, name)
			end
		end
		if #available == 0 then
			table1.playedSongs = {}
			available = list
		end
		local choice = available[math.random(1, #available)]
		table1.playedSongs[choice] = true
		table1.lastSong = choice
		return choice
	end

	local choice = list[math.random(1, #list)]
	table1.lastSong = choice
	return choice
end
