table1.maintoggle = function(togglename, ...)
	local args = {...}
	local argIndex = #args

	local textboxCount = 0
	local modeType = 0
	local animate = true
	local parent = table1.frame
	local scale = 1

	local actionflag = 0
	local actioncount = 0
	if type(args[argIndex]) == "number" and argIndex >= 2 and type(args[argIndex - 1]) == "number" then
		local possibleCount = math.floor(tonumber(args[argIndex]) or 0)
		if possibleCount >= 1 then
			if argIndex >= 3 and type(args[argIndex - 2]) == "number" then
				actioncount = possibleCount
				actionflag = 1
				argIndex -= 1
			elseif argIndex >= 4 and type(args[argIndex - 2]) == "boolean" and type(args[argIndex - 3]) == "boolean" then
				actioncount = possibleCount
				actionflag = 1
				argIndex -= 1
			end
		end
	end

	if type(args[argIndex]) == "boolean" then
		local legacyHasValue = args[argIndex]
		argIndex -= 1
		if argIndex >= 1 and type(args[argIndex]) == "boolean" then
			animate = args[argIndex]
			argIndex -= 1
		else
			animate = true
		end
		modeType = 0
		textboxCount = legacyHasValue and 1 or 0
	else
		textboxCount = math.max(0, math.floor(tonumber(args[argIndex]) or 0))
		argIndex -= 1
		modeType = math.clamp(math.floor(tonumber(args[argIndex]) or 0), 0, 4)
		argIndex -= 1
		if argIndex >= 1 and type(args[argIndex]) == "boolean" then
			animate = args[argIndex]
			argIndex -= 1
		end
	end

	if argIndex >= 1 and typeof(args[argIndex]) == "Instance" then
		parent = args[argIndex]
		argIndex -= 1
	end

	if argIndex >= 1 and type(args[argIndex]) == "number" then
		scale = args[argIndex]
		argIndex -= 1
	end

	scale = scale or 1
	animate = animate ~= false

	if modeType ~= 0 then
		animate = false
	end

	local modes = {}

	for i = 1, argIndex do
