table1.rigworldtoviewport = function(worldpos)
	if not table1.rigcamera or not table1.rigviewport then
		return Vector2.zero, false, 0
	end
	table1.rigabs = table1.rigviewport.AbsoluteSize
	if table1.rigabs.X < 1 or table1.rigabs.Y < 1 then
		return Vector2.zero, false, 0
	end
	table1.rigrel = table1.rigcamera.CFrame:PointToObjectSpace(worldpos)
	if table1.rigrel.Z >= -0.05 then
		return Vector2.zero, false, table1.rigrel.Z
	end
	table1.rigaspect = table1.rigabs.X / table1.rigabs.Y
	table1.rigtan = math.tan(math.rad(table1.rigcamera.FieldOfView) * 0.5)
	table1.rigndcx = (table1.rigrel.X / -table1.rigrel.Z) / (table1.rigtan * table1.rigaspect)
	table1.rigndcy = (table1.rigrel.Y / -table1.rigrel.Z) / table1.rigtan
	table1.rigpx = (table1.rigndcx + 1) * 0.5 * table1.rigabs.X
	table1.rigpy = (1 - table1.rigndcy) * 0.5 * table1.rigabs.Y
	return Vector2.new(table1.rigpx, table1.rigpy), true, -table1.rigrel.Z
end

