	table1.abmain = next(table1.maintoggleState)
	while table1.abmain do
		table1.abstate = table1.maintoggleState[table1.abmain]
		if table1.abstate and table1.abstate.actionflag == 1 and table1.abstate.actionon == "on" and not table1.pcseen[table1.abmain] and table1.abmain.Parent then
