table1.connectchamsplayer = function(targetPlayer, skipUpdate)
	if not targetPlayer then return end
	local connections = table1.chamsplayerconnections[targetPlayer]
	if connections then
		local allConnected = true
		for _, connection in ipairs(connections) do
			if not connection.Connected then allConnected = false break end
		end
		if allConnected then
			if not skipUpdate then table1.updatechamsforplayer(targetPlayer) end
			return
		end
		table1.removeconnections(connections)
	end
	connections = {}
	table1.chamsplayerconnections[targetPlayer] = connections
	table.insert(connections, targetPlayer:GetPropertyChangedSignal("Team"):Connect(function()
		table1.espfriendcache[targetPlayer.UserId] = nil
		if targetPlayer == table1.player then
			if table1.schedulefullesprefresh then table1.schedulefullesprefresh() end
		else
			if table1.espplayerrecords[targetPlayer] then
				table1.playesspppppupdaateee(targetPlayer, table1.espplayerrecords[targetPlayer])
			end
			table1.updatechamsforplayer(targetPlayer)
			table1.esplistdirty = true
			table1.refreshESPRenderConnection()
		end
	end))
	if targetPlayer ~= table1.player then
		table.insert(connections, targetPlayer.CharacterAdded:Connect(function()
			task.defer(function()
				if targetPlayer.Parent == table1.Players then table1.updatechamsforplayer(targetPlayer) end
			end)
		end))
		table.insert(connections, targetPlayer.CharacterRemoving:Connect(function(character)
			local currentHighlight = table1.chamshighlights[targetPlayer]
			if currentHighlight and currentHighlight.Adornee == character then
				currentHighlight:Destroy()
				table1.chamshighlights[targetPlayer] = nil
			end
		end))
	end
	if not skipUpdate then table1.updatechamsforplayer(targetPlayer) end
end

