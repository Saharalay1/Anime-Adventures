	table1.drawcross = function(barsList, use, colorStr, barsStr, lenStr, thickStr, distStr, angStr, trStr)
		for i = 1, 8 do
			if barsList[i] then barsList[i].Visible = false end
		end
		if not use then return end
		table1.nbar = math.clamp(math.floor(tonumber(barsStr) or 4), 1, 8)
		table1.blen = math.clamp(tonumber(lenStr) or 18, 2, 200) * table1.scale
		table1.bthick = math.clamp(tonumber(thickStr) or 2, 0.5, 20) * table1.scale
		table1.bdist = math.clamp(tonumber(distStr) or 8, 0, 300) * table1.scale
		table1.bang = math.rad(tonumber(angStr) or 0)
		table1.btr = math.clamp(tonumber(trStr) or 0.15, 0, 1)
		table1.bcol = table1.parsecolor(colorStr, table1.purple)
		table1.step = (math.pi * 2) / table1.nbar
		for i = 1, table1.nbar do
			table1.bar = barsList[i]
			if table1.bar then
				table1.a = table1.bang + (i - 1) * table1.step
				table1.ox = math.cos(table1.a) * (table1.bdist + table1.blen * 0.5) + table1.aimox
				table1.oy = math.sin(table1.a) * (table1.bdist + table1.blen * 0.5) + table1.aimoy
				table1.bar.Size = UDim2.fromOffset(table1.blen, table1.bthick)
				table1.bar.Position = UDim2.new(0.5, table1.ox, 0.5, table1.oy)
				table1.bar.Rotation = math.deg(table1.a)
				table1.bar.BackgroundColor3 = table1.bcol
				table1.bar.BackgroundTransparency = table1.btr
				table1.bar.Visible = true
				table1.bcorner = table1.bar:FindFirstChildOfClass("UICorner")
				if table1.bcorner then
					table1.bcorner.CornerRadius = UDim.new(0, 0)
				end
			end
		end
	end

	table1.drawcross(table1.aimbotcross1bars, table1.useCr1, table1.getlockedcolorstr(3) or table1.cr1c.Text, table1.cr1bars.Text, table1.cr1len.Text, table1.cr1thick.Text, table1.cr1dist.Text, table1.cr1ang.Text, table1.cr1tr.Text)
	table1.drawcross(table1.aimbotcross2bars, table1.useCr2, table1.getlockedcolorstr(4) or table1.cr2c.Text, table1.cr2bars.Text, table1.cr2len.Text, table1.cr2thick.Text, table1.cr2dist.Text, table1.cr2ang.Text, table1.cr2tr.Text)
end


table1.gettargetpart = function(character)
	if not character then return nil end
	table1.mode = table1.aimbottargetpartmode or 1
	if table1.mode == 1 then
		return character:FindFirstChild("Head")
	elseif table1.mode == 2 then
		return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
	elseif table1.mode == 3 then
		return character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm")
	elseif table1.mode == 4 then
		return character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm")
	elseif table1.mode == 5 then
		return character:FindFirstChild("LeftUpperLeg") or character:FindFirstChild("Left Leg")
	elseif table1.mode == 6 then
		return character:FindFirstChild("RightUpperLeg") or character:FindFirstChild("Right Leg")
	end
	return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

table1.isvalidaimtarget = function(plr)
	if not plr or plr == table1.player then return false end
	table1.pc = table1.playercache[plr]
	if table1.pc then
		table1.char = table1.pc.char
		table1.hum = table1.pc.hum
	else
		table1.char = plr.Character
		table1.hum = table1.char and table1.char:FindFirstChildOfClass("Humanoid")
	end
	if not table1.char or not table1.hum then return false end
	if table1.aimbotdeathcheck and table1.hum.Health <= 0 then return false end
	return table1.istargetallowedcore(plr, table1.aimbotpeopleselected, table1.singulartargetmode or 0, table1.aimbotteamfilter or 1, table1.aimbotspecificteamsselected)
end

table1.getscreenpoint = function(worldpos)
	table1.cam = table1.Workspace.CurrentCamera
	if not table1.cam then return nil, false end
	table1.sp, table1.on = table1.cam:WorldToViewportPoint(worldpos)
	return Vector2.new(table1.sp.X, table1.sp.Y), table1.on and table1.sp.Z > 0
end

table1.wallcheckpass = function(frompos, topos)
	if not table1.aimbotwallcheck then return true end
	table1.params = RaycastParams.new()
	table1.params.FilterType = Enum.RaycastFilterType.Exclude
	table1.params.FilterDescendantsInstances = {table1.player.Character, table1.char}
	table1.result = table1.Workspace:Raycast(frompos, (topos - frompos), table1.params)
	return table1.result == nil
end

table1.findbesttarget = function()
	table1.cam = table1.Workspace.CurrentCamera
	if not table1.cam then return nil end
	table1.aimox = tonumber(table1.aimbotoffsetx and table1.aimbotoffsetx.Text) or 0
	table1.aimoy = tonumber(table1.aimbotoffsety and table1.aimbotoffsety.Text) or 0
	table1.center = Vector2.new(table1.cam.ViewportSize.X * 0.5 + table1.aimox, table1.cam.ViewportSize.Y * 0.5 + table1.aimoy)
	table1.zoneR = math.clamp(tonumber(table1.c1r.Text) or 120, 10, 800) * math.clamp(tonumber(table1.aimbotscale.Text) or 1, 0.25, 4)
	table1.best = nil
	table1.bestscore = nil
	table1.rank = table1.aimbotrankmode or 1
	for _, plr in ipairs(table1.Players:GetPlayers()) do
		if table1.isvalidaimtarget(plr) then
			table1.part = table1.gettargetpart(plr.Character)
			if table1.part then
				table1.screen, table1.onscreen = table1.getscreenpoint(table1.part.Position)
				if table1.onscreen then
					table1.dist2d = (table1.screen - table1.center).Magnitude
					if table1.dist2d <= table1.zoneR then
						if table1.wallcheckpass(table1.cam.CFrame.Position, table1.part.Position) then
							table1.hum = plr.Character:FindFirstChildOfClass("Humanoid")
							table1.hp = table1.hum and table1.hum.Health or 100
							table1.maxhp = table1.hum and table1.hum.MaxHealth or 100
							table1.hpratio = table1.maxhp > 0 and (table1.hp / table1.maxhp) or 1
							table1.score = 0
							if table1.rank == 1 then
								table1.score = -(table1.part.Position - table1.cam.CFrame.Position).Magnitude
							elseif table1.rank == 2 then
								table1.score = -table1.dist2d
							elseif table1.rank == 3 then
								table1.score = (table1.part.Position - table1.cam.CFrame.Position).Magnitude
							elseif table1.rank == 4 then
								table1.score = table1.aimbothealthpercent and -table1.hpratio or -table1.hp
							elseif table1.rank == 5 then
								table1.score = table1.aimbothealthpercent and table1.hpratio or table1.hp
							else
								table1.score = -table1.dist2d
							end
							if table1.bestscore == nil or table1.score > table1.bestscore then
								table1.bestscore = table1.score
								table1.best = {player = plr, part = table1.part, screen = table1.screen}
							end
						end
					end
				end
			end
		end
	end
	return table1.best
end

table1.aimattarget = function(target)
	if not target or not target.part then return end
	table1.cam = table1.Workspace.CurrentCamera
	if not table1.cam then return end
	table1.snap = math.clamp(tonumber(table1.snaprate.Text) or 0.12, 0, 1)
	table1.aimox = tonumber(table1.aimbotoffsetx and table1.aimbotoffsetx.Text) or 0
	table1.aimoy = tonumber(table1.aimbotoffsety and table1.aimbotoffsety.Text) or 0
	table1.vp = table1.cam.ViewportSize
	table1.aimcenter = Vector2.new(table1.vp.X * 0.5 + table1.aimox, table1.vp.Y * 0.5 + table1.aimoy)
	if table1.aimbotmouseaim and not table1.ismobiledevice() then
		table1.mousedelta = target.screen - table1.aimcenter
		if mousemoverel then
			mousemoverel(table1.mousedelta.X * (1 - table1.snap), table1.mousedelta.Y * (1 - table1.snap))
		end
	else
		table1.screenpt, table1.screenon = table1.cam:WorldToViewportPoint(target.part.Position)
		table1.screendel = Vector2.new(table1.screenpt.X, table1.screenpt.Y) - table1.aimcenter
		table1.fov = math.rad(table1.cam.FieldOfView)
		table1.aspect = table1.vp.X / math.max(1, table1.vp.Y)
		table1.halfy = math.max(1, table1.vp.Y * 0.5)
		table1.halfx = math.max(1, table1.vp.X * 0.5)
		table1.yawdelta = math.atan((table1.screendel.X / table1.halfx) * math.tan(table1.fov * 0.5) * table1.aspect)
		table1.pitchdelta = math.atan((table1.screendel.Y / table1.halfy) * math.tan(table1.fov * 0.5))
		table1.newcf = table1.cam.CFrame * CFrame.Angles(-table1.pitchdelta, -table1.yawdelta, 0)
		if table1.snap <= 0 then
			table1.cam.CFrame = table1.newcf
		else
			table1.cam.CFrame = table1.cam.CFrame:Lerp(table1.newcf, 1 - table1.snap)
		end
	end
end

table1.aimbotframestep = function()
