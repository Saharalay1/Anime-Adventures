table1.gethitboxtargets = function()
	table1.hitboxtargets = {}
	table1.hitboxspecificset = {}
	for name,_ in pairs(table1.hitboxtargetspecific) do
		table1.hitboxspecificset[name] = true
	end
	table1.hitboxhasfilters = (table1.hitboxfilter.teams and next(table1.hitboxfilter.teams)) or table1.hitboxfilter.all or table1.hitboxfilter.team or table1.hitboxfilter.enemies
	table1.hitboxhasspecific = next(table1.hitboxtargetspecific) ~= nil
	table1.hitboxisnone = table1.hitboxfilter.none == true
	for _,p in ipairs(table1.Players:GetPlayers()) do
		if p ~= table1.player then
			table1.hitboxisspecific = table1.hitboxhasspecific and (table1.hitboxspecificset[p.Name] or table1.hitboxspecificset[p.DisplayName])
			if table1.singulartargetmode == 1 and table1.hitboxisspecific then
				table.insert(table1.hitboxtargets, p)
			elseif table1.singulartargetmode == 2 and table1.hitboxisspecific then
			else
				table1.hitboxinclude = false
				if table1.hitboxisnone then
					if table1.hitboxisspecific then
						table1.hitboxinclude = true
					end
				elseif table1.hitboxhasspecific and not table1.hitboxhasfilters then
					if table1.hitboxisspecific then
						table1.hitboxinclude = true
					end
				elseif table1.hitboxhasfilters then
					if table1.hitboxfilter.teams and next(table1.hitboxfilter.teams) then
						if p.Team and table1.hitboxfilter.teams[p.Team.Name] then
							table1.hitboxinclude = true
						end
					elseif table1.hitboxfilter.all then
						table1.hitboxinclude = true
					elseif table1.hitboxfilter.team and p.Team and table1.player.Team and p.Team == table1.player.Team then
						table1.hitboxinclude = true
					elseif table1.hitboxfilter.enemies and (not p.Team or not table1.player.Team or p.Team ~= table1.player.Team) then
						table1.hitboxinclude = true
					end
					if table1.hitboxinclude and table1.hitboxisspecific and table1.singulartargetmode ~= 1 then
						table1.hitboxinclude = false
					end
				end
				if table1.hitboxinclude then
					table.insert(table1.hitboxtargets, p)
				end
			end
		end
	end
	return table1.hitboxtargets
end

table1.restorehitboxpart = function(part)
	if not part or not part.Parent then return end
	table1.hitboxorig = table1.hitboxoriginalsizes[part]
	if table1.hitboxorig then
		part.Size = table1.hitboxorig.size
		part.Transparency = table1.hitboxorig.trans
		part.CanCollide = table1.hitboxorig.cancollide
		part.Massless = table1.hitboxorig.massless or false
		if table1.hitboxorig.color then part.Color = table1.hitboxorig.color end
		if table1.hitboxorig.material then part.Material = table1.hitboxorig.material end
		table1.hitboxoriginalsizes[part] = nil
	end
end

table1.savehitboxpart = function(part)
	if not part or table1.hitboxoriginalsizes[part] then return end
	table1.hitboxoriginalsizes[part] = {
		size = part.Size,
		trans = part.Transparency,
		cancollide = part.CanCollide,
		massless = part.Massless,
		color = part.Color,
		material = part.Material
	}
end

table1.applyhitboxtocharacter = function(char)
	if not char or not table1.hitboxmaster then return end
	table1.hitboxhrp = char:FindFirstChild("HumanoidRootPart")
	if not table1.hitboxhrp then return end
	table1.hitboxsa = tonumber(table1.hitboxscaleall) or 1
	if table1.hitboxsa < 0.1 then table1.hitboxsa = 0.1 end
	table1.hitboxheadsc = (table1.hitboxexpander:GetAttribute("Selected1") and (tonumber(table1.hitboxheadscale.Text) or 1) or 1) * table1.hitboxsa
	table1.hitboxtorsosc = (table1.hitboxexpander:GetAttribute("Selected2") and (tonumber(table1.hitboxtorsoscale.Text) or 1) or 1) * table1.hitboxsa
	table1.hitboxlarmsc = (table1.hitboxexpander:GetAttribute("Selected3") and (tonumber(table1.hitboxlarscale.Text) or 1) or 1) * table1.hitboxsa
	table1.hitboxrarmsc = (table1.hitboxexpander:GetAttribute("Selected4") and (tonumber(table1.hitboxrarscale.Text) or 1) or 1) * table1.hitboxsa
	table1.hitboxllegsc = (table1.hitboxexpander:GetAttribute("Selected5") and (tonumber(table1.hitboxllscale.Text) or 1) or 1) * table1.hitboxsa
	table1.hitboxrlegsc = (table1.hitboxexpander:GetAttribute("Selected6") and (tonumber(table1.hitboxrlscale.Text) or 1) or 1) * table1.hitboxsa
	table1.hitboxmaxsc = math.max(table1.hitboxheadsc, table1.hitboxtorsosc, table1.hitboxlarmsc, table1.hitboxrarmsc, table1.hitboxllegsc, table1.hitboxrlegsc)
	table1.hitboxshouldsize = (table1.hitboxvismode == 2) or (table1.hitboxvismode == 0 or table1.hitboxvismode == nil)
	if table1.hitboxvismode == 1 then
		table1.hitboxshouldsize = false
	end
	if table1.hitboxmaxsc <= 1.01 then
		table1.restorehitboxpart(table1.hitboxhrp)
		if table1.hitboxadornments and table1.hitboxadornments[table1.hitboxhrp] then
			table1.hitboxadornments[table1.hitboxhrp]:Destroy()
			table1.hitboxadornments[table1.hitboxhrp] = nil
		end
		return
	end
	if table1.hitboxshouldsize then
		table1.savehitboxpart(table1.hitboxhrp)
		table1.hitboxnewsize = Vector3.new(table1.hitboxmaxsc, table1.hitboxmaxsc, table1.hitboxmaxsc)
		if table1.hitboxhrp.Size ~= table1.hitboxnewsize then
			table1.hitboxhrp.Size = table1.hitboxnewsize
		end
		table1.hitboxhrp.CanCollide = false
		if table1.hitboxvismode == 2 then
			table1.hitboxhrp.Transparency = table1.hitboxvistrans
			table1.hitboxhrp.Color = table1.hitboxviscolor
			table1.hitboxhrp.Material = Enum.Material.Neon
		else
			table1.hitboxhrp.Transparency = 1
		end
		if table1.hitboxadornments and table1.hitboxadornments[table1.hitboxhrp] then
			table1.hitboxadornments[table1.hitboxhrp]:Destroy()
			table1.hitboxadornments[table1.hitboxhrp] = nil
		end
	else
		table1.restorehitboxpart(table1.hitboxhrp)
		if not table1.hitboxadornments then table1.hitboxadornments = {} end
		table1.hitboxad = table1.hitboxadornments[table1.hitboxhrp]
		if not table1.hitboxad or not table1.hitboxad.Parent then
			table1.hitboxad = Instance.new("BoxHandleAdornment")
			table1.hitboxad.Adornee = table1.hitboxhrp
			table1.hitboxad.AlwaysOnTop = true
			table1.hitboxad.ZIndex = 5
			table1.hitboxad.Parent = table1.hitboxhrp
			table1.hitboxadornments[table1.hitboxhrp] = table1.hitboxad
		end
		table1.hitboxad.Size = Vector3.new(table1.hitboxmaxsc, table1.hitboxmaxsc, table1.hitboxmaxsc)
		table1.hitboxad.Color3 = table1.hitboxviscolor or Color3.fromRGB(255, 0, 0)
		table1.hitboxad.Transparency = table1.hitboxvistrans or 0.5
		table1.hitboxad.Visible = true
	end
end

