		local st = table1.maintoggleState[table1.rezeAutoloadSelect]
		if st and st.dropdownButtons and st.dropdownButtons[mode] then
			local t = st.dropdownButtons[mode].Text
			if t and t ~= "None" and t ~= "Select... ◀" and t ~= "Select... ▼" then
				name = t
			end
		elseif table1.autoloadRezeNames and table1.autoloadRezeNames[mode] then
			local t = table1.autoloadRezeNames[mode]
			if t and t ~= "None" then
				name = t
			end
		end
	end
	table1.autoloadData.rezeConfig = name
