table1.getespcolor = function(valueBox, fallback, colorValues)
	if not valueBox then
		return fallback
	end
	colorValues = colorValues or table1.espsettingscolorvalues
	local red, green, blue = valueBox.Text:match("^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$")
	if not red then
		return colorValues[valueBox] or fallback
	end
	red, green, blue = tonumber(red), tonumber(green), tonumber(blue)
	if not red or not green or not blue or red > 255 or green > 255 or blue > 255 then
		return colorValues[valueBox] or fallback
	end
	local color = Color3.fromRGB(red, green, blue)
	colorValues[valueBox] = color
	return color
end

table1.getesptransparency = function(valueBox, fallback)
	local value = valueBox and tonumber(valueBox.Text)
	if value == nil then
