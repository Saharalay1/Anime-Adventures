						end
					end
					table1.line = table1.esptracerlines[table1.targetplayer]
					if table1.line and table1.line.Parent and table1.record.tracerActive then
						table1.point = table1.camera:WorldToViewportPoint(table1.record.root.Position)
						if table1.point.Z > 0 then
							table1.finish = Vector2.new(table1.point.X, table1.point.Y)
							table1.delta = table1.finish - table1.esptracerorigin
							table1.line.Position = UDim2.fromOffset((table1.esptracerorigin.X + table1.finish.X) * 0.5, (table1.esptracerorigin.Y + table1.finish.Y) * 0.5)
							table1.line.Size = UDim2.fromOffset(math.max(1, table1.delta.Magnitude), table1.esprendercache.thickness)
							table1.line.Rotation = math.deg(math.atan2(table1.delta.Y, table1.delta.X))
							if not table1.line.Visible then table1.line.Visible = true end
							table1.trcol = table1.record.tracerColor or table1.purple
							if table1.line.BackgroundColor3 ~= table1.trcol then table1.line.BackgroundColor3 = table1.trcol end
							if table1.line.BackgroundTransparency ~= table1.esprendercache.transparency then table1.line.BackgroundTransparency = table1.esprendercache.transparency end
						else
							if table1.line.Visible then table1.line.Visible = false end
						end
					elseif table1.line and table1.line.Visible then
						table1.line.Visible = false
					end
				end
			end
		end)
	elseif not table1.needsrender and table1.esprenderconnection then
		table1.esprenderconnection:Disconnect()
		table1.esprenderconnection = nil
	end
end
