table1.playsong = function(songname, skipHistory)
	if type(songname) ~= "string" or songname == "" then return end
	if not songname:lower():match("%.%w+$") then
	    songname = songname .. ".mp3"
	end
	table1.ensureSongFolders()

	if table1.songInstance then
		table1.songInstance:Stop()
		table1.songInstance:Destroy()
		table1.songInstance = nil
	end
	table1.songPaused = false

	local fullPath = table1.folder1 .. "/" .. table1.folderInsidefolder1 .. "/" .. songname
	if not isfile(fullPath) then return end
	
	local cleanName = songname:gsub("%.%w+$", "")
	table1.lastPlayedSong = cleanName
	table1.songHistory = table1.songHistory or {}
	table1.songHistoryIndex = table1.songHistoryIndex or 0
	
	if not skipHistory then
		for i = #table1.songHistory, table1.songHistoryIndex + 1, -1 do
			table.remove(table1.songHistory, i)
		end
	
		if table1.songHistory[table1.songHistoryIndex] ~= cleanName then
			table.insert(table1.songHistory, cleanName)
			table1.songHistoryIndex = #table1.songHistory
		end
	end
	local sound = Instance.new("Sound")
	sound.SoundId = getcustomasset(fullPath)
	sound.Volume = table1.songVolume or 1
	sound.Looped = false
	sound.Parent = table1.SoundService
	table1.songInstance = sound
	table1.currentSong = songname
	if table1.songendedhandle then
		table1.onsongended(table1.songendedhandle)
	end

sound:Play()
end
