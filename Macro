table1.computemodelbounds = function(model, relativeTo)
	local minV = Vector3.new(math.huge, math.huge, math.huge)
	local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
	local hasParts = false
	local originCF = relativeTo and relativeTo.CFrame or CFrame.new()
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Name ~= "Viz3DBounds" and p.Name ~= "VizWall" and p.Transparency < 1 then
			hasParts = true
			local cf = originCF:ToObjectSpace(p.CFrame)
			local half = p.Size * 0.5
			local corners = {
				Vector3.new(-half.X, -half.Y, -half.Z),
				Vector3.new( half.X, -half.Y, -half.Z),
				Vector3.new(-half.X,  half.Y, -half.Z),
				Vector3.new( half.X,  half.Y, -half.Z),
				Vector3.new(-half.X, -half.Y,  half.Z),
				Vector3.new( half.X, -half.Y,  half.Z),
				Vector3.new(-half.X,  half.Y,  half.Z),
				Vector3.new( half.X,  half.Y,  half.Z),
			}
			for _, c in ipairs(corners) do
				local world = cf:PointToWorldSpace(c)
				minV = Vector3.new(math.min(minV.X, world.X), math.min(minV.Y, world.Y), math.min(minV.Z, world.Z))
				maxV = Vector3.new(math.max(maxV.X, world.X), math.max(maxV.Y, world.Y), math.max(maxV.Z, world.Z))
			end
		end
	end
	if not hasParts then
		return Vector3.new(2, 5, 1), CFrame.new(0, 0, 0)
	end
	local size = maxV - minV
	local center = (minV + maxV) * 0.5
	return size, CFrame.new(center)
end

