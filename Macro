table1.gethealthcolor = function(ratio)
	ratio = math.clamp(ratio, 0, 1)
	local red = Color3.fromRGB(255, 0, 0)
	local orange = Color3.fromRGB(255, 128, 0)
	local yellow = Color3.fromRGB(255, 255, 0)
	local green = Color3.fromRGB(0, 255, 0)
	if ratio < 1 / 3 then
		return red:Lerp(orange, ratio * 3)
	elseif ratio < 2 / 3 then
		return orange:Lerp(yellow, (ratio - 1 / 3) * 3)
	end
	return yellow:Lerp(green, (ratio - 2 / 3) * 3)
end

