table1.songlist = function()
	table1.ensureSongFolders()
	local songsPath = table1.folder1 .. "/" .. table1.folderInsidefolder1
	local list = {}

	for _, file in ipairs(listfiles(songsPath)) do
		local name = file:match("([^/\\]+)$")
		if name and (name:lower():match("%.mp3$") or name:lower():match("%.ogg$") or name:lower():match("%.wav$")) then
			table.insert(list, (name:gsub("%.%w+$", "")))
		end
	end
	return list
end
