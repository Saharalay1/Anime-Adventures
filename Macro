table1.restoreplayerclipcharacter = function(character)
	if not character then return end
	for part, original in pairs(table1.playercliporiginall) do
		if part and original and (original.character == character or part:IsDescendantOf(character)) then
			if part.Parent then part.CanCollide = original.cancollide end
			table1.playercliporiginall[part] = nil
		end
	end
end
table1.applyplayerclippart = function(thing, character)
	if not thing or not thing:IsA("BasePart") then return end
	if table1.playercliporiginall[thing] == nil or table1.playercliporiginall[thing].character ~= character then
		table1.playercliporiginall[thing] = {cancollide = thing.CanCollide, character = character}
	end
	thing.CanCollide = false
end
table1.setplayerclipp = function(player, character)
	if player == table1.player or not table1.playerclip or not player then return end
	character = character or player.Character
	if not character or not character.Parent then return end
	table1.playerclippreviouscharacter = table1.playerclipcharacters[player]
	if table1.playerclipdescendantconnections[player] then
		table1.playerclipdescendantconnections[player]:Disconnect()
		table1.playerclipdescendantconnections[player] = nil
	end
	if table1.playerclippreviouscharacter and table1.playerclippreviouscharacter ~= character then
		table1.restoreplayerclipcharacter(table1.playerclippreviouscharacter)
	end
	table1.playerclipcharacters[player] = character
	table1.playerclipdescendants = character:GetDescendants()
	table1.pclpi = 1
	while table1.pclpi <= #table1.playerclipdescendants do
		table1.applyplayerclippart(table1.playerclipdescendants[table1.pclpi], character)
		table1.pclpi += 1
	end
	if character:IsA("Model") then
		table1.pclchildren = character:GetChildren()
		table1.pclpi = 1
		while table1.pclpi <= #table1.pclchildren do
			table1.applyplayerclippart(table1.pclchildren[table1.pclpi], character)
			table1.pclpi += 1
		end
	end
	table1.playerclipdescendantconnections[player] = character.DescendantAdded:Connect(function(thing)
		if not table1.playerclip then return end
		if table1.playerclipcharacters[player] ~= character then return end
		if player.Character ~= character then return end
		table1.applyplayerclippart(thing, character)
	end)
end
table1.bindplayerclipcharacter = function(player)
	if not player or player == table1.player then return end
	if table1.playerclipcharacterconnections[player] then table1.playerclipcharacterconnections[player]:Disconnect() table1.playerclipcharacterconnections[player] = nil end
	if table1.playerclipcharacterremovingconnections[player] then table1.playerclipcharacterremovingconnections[player]:Disconnect() table1.playerclipcharacterremovingconnections[player] = nil end
	table1.playerclipcharacterconnections[player] = player.CharacterAdded:Connect(function(character)
		if not table1.playerclip or player == table1.player then return end
		task.defer(function()
			if table1.playerclip and player.Character == character and character.Parent then
				table1.setplayerclipp(player, character)
			end
		end)
	end)
	table1.playerclipcharacterremovingconnections[player] = player.CharacterRemoving:Connect(function(character)
		if table1.playerclipdescendantconnections[player] then
			table1.playerclipdescendantconnections[player]:Disconnect()
			table1.playerclipdescendantconnections[player] = nil
		end
		table1.restoreplayerclipcharacter(character)
		if table1.playerclipcharacters[player] == character then
			table1.playerclipcharacters[player] = nil
		end
	end)
end
table1.enableplayerclipp = function()
	if table1.playerclip then return end
	table1.playerclip = true
	table1.playerclipcharacters = {}
	if table1.playerclipplayeraddedconnection then table1.playerclipplayeraddedconnection:Disconnect() table1.playerclipplayeraddedconnection = nil end
