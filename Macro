		elseif globalTeamCheck and sameTeam then
			table1.esppass = false
		elseif globalFriendCheck and table1.isespfriend(targetPlayer) then
			table1.esppass = false
		end
	end
	if table1.isespsettingenabled(19) then
		if table1.esphaspeople then
			return table1.espispeople == true
		end
		return false
	end
	if table1.singulartargetmode == 1 then
		if table1.espispeople then
			return true
		end
		return table1.esppass
	end
	if table1.esphaspeople and not table1.espfilteractive then
