table1.boundybodyget = function(record)
	local root = record.root
	if not root or not root.Parent then
		return nil
	end
	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	local found = false
	for _, part in ipairs(record.bodyParts or {}) do
		if part.Parent then
			local half = part.Size * 0.5
			for x = -1, 1, 2 do
				for y = -1, 1, 2 do
					for z = -1, 1, 2 do
						local worldPoint = part.CFrame:PointToWorldSpace(Vector3.new(half.X * x, half.Y * y, half.Z * z))
						local localPoint = root.CFrame:PointToObjectSpace(worldPoint)
						minX = math.min(minX, localPoint.X)
						minY = math.min(minY, localPoint.Y)
						minZ = math.min(minZ, localPoint.Z)
						maxX = math.max(maxX, localPoint.X)
						maxY = math.max(maxY, localPoint.Y)
						maxZ = math.max(maxZ, localPoint.Z)
						found = true
					end
				end
			end
		end
	end
	if not found then
		return nil
	end
	return Vector3.new(minX, minY, minZ), Vector3.new(maxX, maxY, maxZ)
end

table1.screembodybounds = function(record, camera)
	local root = record.root
	if not root or not root.Parent or not camera then
		return nil
	end
	local rootPoint = camera:WorldToViewportPoint(root.Position)
	if rootPoint.Z <= 0 then
		return nil
	end
	local minX, minY = math.huge, math.huge
	local maxX, maxY = -math.huge, -math.huge
	local found = false
	for _, part in ipairs(record.bodyParts or {}) do
		if part.Parent then
			local half = part.Size * 0.5
			for x = -1, 1, 2 do
				for y = -1, 1, 2 do
					for z = -1, 1, 2 do
						local worldPoint = part.CFrame:PointToWorldSpace(Vector3.new(half.X * x, half.Y * y, half.Z * z))
						local screenPoint = camera:WorldToViewportPoint(worldPoint)
						if screenPoint.Z > 0 then
							minX = math.min(minX, screenPoint.X)
							minY = math.min(minY, screenPoint.Y)
							maxX = math.max(maxX, screenPoint.X)
							maxY = math.max(maxY, screenPoint.Y)
							found = true
						end
					end
				end
			end
		end
	end
	if not found then
		return nil
	end
	return minX, minY, maxX, maxY, rootPoint
end

