		end
		table1.cfgmain = next(table1.maintoggleState, table1.cfgmain)
	end
	if table1.refreshpcactionsdisplay then
		table1.refreshpcactionsdisplay()
	end
	table1.cfginfo = data["Information Display"]
	if type(table1.cfginfo) == "table" then
