					table1.cfgi = 1
					while table1.cfgi <= table1.cfgstate.modecount do
						table1.cfgsel = false
						if table1.cfgtitle == "Specific Teams Filter" and type(table1.cfgentry.teamnames) == "table" and table1.cfgstate.dropdownButtons and table1.cfgstate.dropdownButtons[table1.cfgi] then
							table1.cfgsel = table1.cfgentry.teamnames[table1.cfgstate.dropdownButtons[table1.cfgi].Text] == true
						elseif type(table1.cfgentry.selected) == "table" then
							table1.cfgsel = table1.cfgentry.selected[tostring(table1.cfgi)] == true or table1.cfgentry.selected[table1.cfgi] == true
						end
						table1.cfgmain:SetAttribute("Selected" .. table1.cfgi, table1.cfgsel)
						if table1.cfgstate.modeStrokes and table1.cfgstate.modeStrokes[table1.cfgi] then
							table1.cfgstate.modeStrokes[table1.cfgi].Transparency = table1.cfgsel and 0 or 1
						end
						if table1.cfgstate.selectedModes then
							table1.cfgstate.selectedModes[table1.cfgi] = table1.cfgsel
						end
						if table1.cfgstate.dropdownButtons and table1.cfgstate.dropdownButtons[table1.cfgi] then
							table1.cfgstate.dropdownButtons[table1.cfgi].BackgroundColor3 = table1.cfgsel and table1.selectedtabcolor or table1.tabinactive
							table1.cfgstate.dropdownButtons[table1.cfgi].BackgroundTransparency = table1.cfgsel and 0 or 0.15
						end
						table1.cfgi += 1
					end
					if table1.cfgstate.updateDropdownText then
						table1.cfgstate.updateDropdownText()
					end
				end
				table1.cfgmode = tonumber(table1.cfgentry.mode)
				if table1.cfgmode == nil then
					table1.cfgmode = 0
				end
				if table1.cfgstate.modeType == 0 and table1.cfgstate.modecount then
					if table1.cfgmode < 0 then table1.cfgmode = 0 end
					if table1.cfgmode > table1.cfgstate.modecount then table1.cfgmode = 0 end
				elseif table1.cfgstate.modeType == 4 and table1.cfgstate.modecount then
					if table1.cfgmode < 0 then table1.cfgmode = 0 end
					if table1.cfgmode > table1.cfgstate.modecount then table1.cfgmode = 0 end
				end
				table1.cfgmain:SetAttribute("Mode", table1.cfgmode)
				table1.cfgstate.currentmode = table1.cfgmode
				table1.cfgstate.lastMode = table1.cfgmode
				if table1.cfgstate.modeType == 0 and table1.cfgstate.setoutline then
					table1.cfgstate.setoutline(table1.cfgmode, true)
				end
				if table1.cfgstate.modeType == 4 and table1.cfgstate.updateDropdownText then
					table1.cfgstate.selectedMode = table1.cfgmode
					table1.cfgstate.updateDropdownText()
				end
				if type(table1.cfgentry.values) == "table" then
					table1.cfgi = 1
					table1.cfgbox = (table1.cfgstate.valueBoxes or {})[table1.cfgi]
					while table1.cfgbox do
