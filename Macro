table1.saveconfigfile = function(name)
	if not name or name == "" or name == "(defaults)" then
		return
	end
	table1.ensureconfigfolders()
	table1.configdata = table1.collectconfigdata()
	table1.configjson = table1.HttpService:JSONEncode(table1.configdata)
	writefile(table1.configspath .. "/" .. name .. table1.configextension, table1.configjson)
end
table1.loadconfigfile = function(name)
	if not name or name == "" then
		return
	end
	if name == "(defaults)" then
		if table1.defaultsdata then
			table1.applyconfigdata(table1.defaultsdata)
		end
		return
	end
	table1.ensureconfigfolders()
	table1.configpath = table1.configspath .. "/" .. name .. table1.configextension
	if not isfile(table1.configpath) then
		return
	end
	table1.configraw = readfile(table1.configpath)
	if not table1.configraw or table1.configraw == "" then
		if table1.defaultsdata then
			table1.applyconfigdata(table1.defaultsdata)
		end
		return
	end
	table1.configrawtrim = string.gsub(table1.configraw, "^%s+", "")
	if string.sub(table1.configrawtrim, 1, 1) ~= "{" then
		if table1.defaultsdata then
			table1.applyconfigdata(table1.defaultsdata)
		end
		return
	end
	table1.configok, table1.configdata = true, nil
	table1.configdecoded = table1.HttpService:JSONDecode(table1.configraw)
	if type(table1.configdecoded) ~= "table" then
		if table1.defaultsdata then
			table1.applyconfigdata(table1.defaultsdata)
		end
		return
	end
	table1.applyconfigdata(table1.configdecoded)
end
table1.deleteconfigfile = function(name)
	if not name or name == "" or name == "(defaults)" then
		return
	end
	table1.ensureconfigfolders()
	table1.configpath = table1.configspath .. "/" .. name .. table1.configextension
	if isfile(table1.configpath) then
		delfile(table1.configpath)
	end
end
