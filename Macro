table1.updaterigesp2d = function()
	if not table1.rigcamera or not table1.righrp or not table1.rigespoverlay or not table1.rigviewport or not table1.rigmodel then return end
	table1.rigabs = table1.rigviewport.AbsoluteSize
	if table1.rigabs.X < 1 or table1.rigabs.Y < 1 then return end
	table1.updaterigoverlays()
	table1.rigminx, table1.rigminy = math.huge, math.huge
	table1.rigmaxx, table1.rigmaxy = -math.huge, -math.huge
	table1.rigfoundpt = false
	if table1.rigpartmodel ~= table1.rigmodel then
		table1.rigpartmodel = table1.rigmodel
		table1.rigparts = table1.rigmodel:GetDescendants()
	end
	for _, part in ipairs(table1.rigparts or {}) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "Viz3DBounds" and part.Name ~= "VizWall" and part.Transparency < 1 then
			table1.righalf = part.Size * 0.5
			for ox = -1, 1, 2 do
				for oy = -1, 1, 2 do
					for oz = -1, 1, 2 do
						table1.rigworldpt = part.CFrame:PointToWorldSpace(Vector3.new(table1.righalf.X * ox, table1.righalf.Y * oy, table1.righalf.Z * oz))
						table1.rigscreen, table1.rigsonscreen = table1.rigworldtoviewport(table1.rigworldpt)
						if table1.rigsonscreen then
							table1.rigminx = math.min(table1.rigminx, table1.rigscreen.X)
							table1.rigminy = math.min(table1.rigminy, table1.rigscreen.Y)
							table1.rigmaxx = math.max(table1.rigmaxx, table1.rigscreen.X)
							table1.rigmaxy = math.max(table1.rigmaxy, table1.rigscreen.Y)
							table1.rigfoundpt = true
						end
					end
				end
			end
		end
	end
	table1.righrpscreen, table1.righrpon = table1.rigworldtoviewport(table1.righrp.Position)
	table1.rig2don = table1.d2boxxesp and table1.d2boxxesp:GetAttribute("Mode") == 1
	table1.rigopts = table1.infographicoptions or {}
	table1.riginfoon = table1.infographicIsVisible and table1.infographicIsVisible()
	if table1.rigfoundpt and (table1.rig2don or table1.riginfoon) then
		table1.rigbw = math.max(4, table1.rigmaxx - table1.rigminx)
		table1.rigbh = math.max(4, table1.rigmaxy - table1.rigminy)
		if table1.rig2dframe then
			table1.rig2dframe.Visible = table1.rig2don == true
			table1.rig2dframe.Position = UDim2.fromOffset(table1.rigminx, table1.rigminy)
			table1.rig2dframe.Size = UDim2.fromOffset(table1.rigbw, table1.rigbh)
			if table1.rig2dstroke then
				table1.rig2dstroke.Color = table1.getespcolor(table1.d2boxxespcolor, table1.purple, table1.esp2dcolorvalues)
				table1.rig2dstroke.Thickness = math.clamp(tonumber(table1.d2boxxespthickness and table1.d2boxxespthickness.Text) or 1, 1, 10)
				table1.rig2dstroke.Transparency = table1.getesptransparency(table1.d2boxxesptransparency, 0)
			end
		end
		table1.rigtextsize = math.clamp(math.floor(12 * (tonumber(table1.infographictextsize and table1.infographictextsize.Text) or 1) + 0.5), 8, 28)
		table1.rigtextgap = math.max(1, math.floor(1.5 * (tonumber(table1.infographictextsize and table1.infographictextsize.Text) or 1) + 0.5))
		table1.righasusername = table1.riginfoon and table1.rigopts[1] == true
		table1.righasdisplay = table1.riginfoon and table1.rigopts[2] == true
		table1.righashealth = table1.riginfoon and table1.rigopts[3] == true
		table1.righasdist = table1.riginfoon and table1.rigopts[4] == true
		table1.rigbarmode = table1.rigopts[7] == true
		table1.rigbarleft = table1.rigopts[8] == true
		table1.rigbarright = table1.rigopts[10] == true
		table1.rigbarloc = table1.rigbarleft and table1.rigbarright and "Bottom" or table1.rigbarleft and "Left" or table1.rigbarright and "Right" or "Top"
		table1.rigbarh = table1.righashealth and table1.rigbarmode and math.clamp(4 * (tonumber(table1.infographichealthbarsize and table1.infographichealthbarsize.Text) or 1), 2, 12) or 0
		table1.rigstacky = table1.rigminy
		table1.rigratio = math.clamp(table1.rigvishealth / 1000, 0, 1)
		table1.righealthcolor = table1.gethealthcolor and table1.gethealthcolor(table1.rigratio) or Color3.fromRGB(0, 255, 0)
		if table1.righashealth and table1.rigbarmode and table1.rigbarloc == "Top" then
			table1.rigstacky = table1.rigminy - table1.rigbarh - table1.rigtextgap
		elseif table1.righashealth and not table1.rigbarmode then
			table1.rigstacky -= table1.rigtextsize + table1.rigtextgap
			table1.setriglabel(table1.righealthlabelgui, table1.rigopts[11] and (tostring(math.floor(table1.rigratio * 100)) .. "%") or tostring(table1.rigvishealth), table1.rigopts[10] and table1.getespcolor(table1.infographictextcolor, table1.white) or table1.righealthcolor, (table1.rigminx + table1.rigmaxx) * 0.5, table1.rigstacky, math.max(60, table1.rigbw))
		elseif table1.righealthlabelgui then
			table1.righealthlabelgui.Visible = false
		end
		if table1.righasdist then
			table1.rigstacky -= table1.rigtextsize + table1.rigtextgap
			table1.setriglabel(table1.rigdistlabel, "12 studs", table1.getespcolor(table1.infographictextcolor, table1.white), (table1.rigminx + table1.rigmaxx) * 0.5, table1.rigstacky, math.max(80, table1.rigbw + 20))
		elseif table1.rigdistlabel then
			table1.rigdistlabel.Visible = false
		end
		if table1.righasdisplay then
			table1.rigstacky -= table1.rigtextsize + table1.rigtextgap
			table1.setriglabel(table1.rignamelabel, table1.player.DisplayName or table1.player.Name, table1.getespcolor(table1.infographictextcolor, table1.white), (table1.rigminx + table1.rigmaxx) * 0.5, table1.rigstacky, math.max(80, table1.rigbw + 20))
		elseif table1.rignamelabel then
			table1.rignamelabel.Visible = false
		end
		if table1.righasusername then
			table1.rigstacky -= table1.rigtextsize + table1.rigtextgap
			if not table1.riguserlabel then
				table1.riguserlabel = Instance.new("TextLabel")
				table1.riguserlabel.BackgroundTransparency = 1
				table1.riguserlabel.Font = table1.font
				table1.riguserlabel.TextSize = 12
				table1.riguserlabel.TextColor3 = table1.white
				table1.riguserlabel.AnchorPoint = Vector2.new(0.5, 0)
				table1.riguserlabel.Visible = false
				table1.riguserlabel.ZIndex = 62
				table1.riguserlabel.Parent = table1.rigespoverlay
			end
			table1.setriglabel(table1.riguserlabel, table1.player.Name, table1.getespcolor(table1.infographictextcolor, table1.white), (table1.rigminx + table1.rigmaxx) * 0.5, table1.rigstacky, math.max(80, table1.rigbw + 20))
		elseif table1.riguserlabel then
			table1.riguserlabel.Visible = false
		end
		if table1.righashealth and table1.rigbarmode and table1.righealthbarback then
			table1.righealthbarback.Visible = true
			table1.righealthbarfill.BackgroundColor3 = table1.righealthcolor
			if table1.rigbarloc == "Left" then
				table1.righealthbarback.Size = UDim2.fromOffset(table1.rigbarh, table1.rigbh)
				table1.righealthbarback.Position = UDim2.fromOffset(table1.rigminx - table1.rigbarh - 3, table1.rigminy)
				table1.righealthbarfill.Position = UDim2.fromOffset(0, table1.rigbh * (1 - table1.rigratio))
				table1.righealthbarfill.Size = UDim2.fromOffset(table1.rigbarh, math.max(1, table1.rigbh * table1.rigratio))
			elseif table1.rigbarloc == "Right" then
				table1.righealthbarback.Size = UDim2.fromOffset(table1.rigbarh, table1.rigbh)
				table1.righealthbarback.Position = UDim2.fromOffset(table1.rigmaxx + 3, table1.rigminy)
				table1.righealthbarfill.Position = UDim2.fromOffset(0, table1.rigbh * (1 - table1.rigratio))
				table1.righealthbarfill.Size = UDim2.fromOffset(table1.rigbarh, math.max(1, table1.rigbh * table1.rigratio))
			elseif table1.rigbarloc == "Bottom" then
				table1.righealthbarback.Size = UDim2.fromOffset(table1.rigbw, table1.rigbarh)
				table1.righealthbarback.Position = UDim2.fromOffset(table1.rigminx, table1.rigmaxy + 3)
				table1.righealthbarfill.Position = UDim2.fromOffset(0, 0)
				table1.righealthbarfill.Size = UDim2.fromOffset(math.max(1, table1.rigbw * table1.rigratio), table1.rigbarh)
			else
				table1.righealthbarback.Size = UDim2.fromOffset(table1.rigbw, table1.rigbarh)
				table1.righealthbarback.Position = UDim2.fromOffset(table1.rigminx, table1.rigminy - table1.rigbarh - table1.rigtextgap)
				table1.righealthbarfill.Position = UDim2.fromOffset(0, 0)
				table1.righealthbarfill.Size = UDim2.fromOffset(math.max(1, table1.rigbw * table1.rigratio), table1.rigbarh)
			end
			if table1.righealthbarback:FindFirstChildOfClass("UIStroke") then
				table1.righealthbarback:FindFirstChildOfClass("UIStroke").Thickness = math.clamp(tonumber(table1.infographichealthbaroutline.Text) or 1, 0, 10)
			end
			if table1.righealthlabelgui then table1.righealthlabelgui.Visible = false end
		else
			if table1.righealthbarback then table1.righealthbarback.Visible = false end
		end
	else
		if table1.rig2dframe then table1.rig2dframe.Visible = false end
		if table1.rignamelabel then table1.rignamelabel.Visible = false end
		if table1.rigdistlabel then table1.rigdistlabel.Visible = false end
		if table1.righealthlabelgui then table1.righealthlabelgui.Visible = false end
		if table1.righealthbarback then table1.righealthbarback.Visible = false end
	end
	table1.rigtracermode = table1.tracerss and table1.tracerss:GetAttribute("Mode") or 0
	if table1.rigtracermode >= 2 and table1.righrpon and table1.rigtracerline then
		table1.rigoriginy = table1.rigtracermode == 3 and table1.rigabs.Y * 0.5 or table1.rigtracermode == 4 and table1.rigabs.Y - 2 or 2
		table1.rigorigin = Vector2.new(table1.rigabs.X * 0.5, table1.rigoriginy)
		table1.rigfinish = table1.righrpscreen
		table1.rigdelta = table1.rigfinish - table1.rigorigin
		table1.rigthick = math.clamp(tonumber(table1.tracersthickness and table1.tracersthickness.Text) or 1, 0.5, 10)
		table1.rigtracerline.Visible = table1.righrpon
		table1.rigtracerline.BackgroundColor3 = table1.getespcolor(table1.tracersscolor, table1.purple, table1.esptracercolorvalues)
		table1.rigtracerline.BackgroundTransparency = table1.getesptransparency(table1.tracersstransparency, 0)
		table1.rigtracerline.AnchorPoint = Vector2.new(0.5, 0.5)
		table1.rigtracerline.Position = UDim2.fromOffset((table1.rigorigin.X + table1.rigfinish.X) * 0.5, (table1.rigorigin.Y + table1.rigfinish.Y) * 0.5)
		table1.rigtracerline.Size = UDim2.fromOffset(math.max(1, table1.rigdelta.Magnitude), table1.rigthick)
		table1.rigtracerline.Rotation = math.deg(math.atan2(table1.rigdelta.Y, table1.rigdelta.X))
	elseif table1.rigtracerline then
		table1.rigtracerline.Visible = false
	end
end

