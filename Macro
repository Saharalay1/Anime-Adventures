		if table1.espteamfilter.enemies and not table1.same then table1.esppass = true end
	end
	if table1.esppass then
		local globalTeamCheck, globalFriendCheck, sameTeam, perTeamBlock, perFriendBlock = table1.getespeffectivechecks(targetPlayer, espType)
		if perTeamBlock then
			table1.esppass = false
		elseif perFriendBlock and table1.isespfriend(targetPlayer) then
