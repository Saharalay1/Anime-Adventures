		record.box3DFill.Visible = fillTransparency < 1
		record.box3DFill.AlwaysOnTop = true
		record.box3DFill.ZIndex = 1
	end
	if record.box3DLines then
		local sx, sy, sz = record.box3DFixedSize.X * 0.5, record.box3DFixedSize.Y * 0.5, record.box3DFixedSize.Z * 0.5
		local edges = {
			{Vector3.new(-sx, -sy, -sz), Vector3.new(sx, -sy, -sz)},
			{Vector3.new(-sx, -sy, sz), Vector3.new(sx, -sy, sz)},
			{Vector3.new(-sx, sy, -sz), Vector3.new(sx, sy, -sz)},
			{Vector3.new(-sx, sy, sz), Vector3.new(sx, sy, sz)},
			{Vector3.new(-sx, -sy, -sz), Vector3.new(-sx, sy, -sz)},
			{Vector3.new(sx, -sy, -sz), Vector3.new(sx, sy, -sz)},
			{Vector3.new(-sx, -sy, sz), Vector3.new(-sx, sy, sz)},
			{Vector3.new(sx, -sy, sz), Vector3.new(sx, sy, sz)},
			{Vector3.new(-sx, -sy, -sz), Vector3.new(-sx, -sy, sz)},
			{Vector3.new(sx, -sy, -sz), Vector3.new(sx, -sy, sz)},
			{Vector3.new(-sx, sy, -sz), Vector3.new(-sx, sy, sz)},
			{Vector3.new(sx, sy, -sz), Vector3.new(sx, sy, sz)},
		}
		for i = 1, 12 do
			local line = record.box3DLines[i]
			if line and line.Parent then
				local a, b = edges[i][1], edges[i][2]
				local delta = b - a
				line.Adornee = record.box3DPart
				line.CFrame = CFrame.new(a, b)
				line.Length = delta.Magnitude
				line.Thickness = math.max(1, thickness)
				line.Color3 = Color3.new(outlineColor.R, outlineColor.G, outlineColor.B) -- pure color, true white stays white
				line.Transparency = outlineTransparency
				line.Visible = outlineTransparency < 1
				line.AlwaysOnTop = true
				line.ZIndex = 10
			end
		end
	end
end
