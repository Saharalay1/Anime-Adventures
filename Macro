table1.getconfiglist = function()
	table1.ensureconfigfolders()
	table1.configlistnames = {"(defaults)"}
	table1.cfgfiles = listfiles(table1.configspath)
	table1.cfgi = 1
	table1.cfgfile = table1.cfgfiles[table1.cfgi]
	while table1.cfgfile do
		table1.configname = table1.cfgfile:match("([^/\\]+)$")
		if table1.configname and table1.configname:lower():match("%.json$") then
			table1.confignamestripped = table1.configname:gsub("%.json$", "")
			if table1.confignamestripped ~= "(defaults)" then
				table.insert(table1.configlistnames, table1.confignamestripped)
			end
		end
		table1.cfgi += 1
		table1.cfgfile = table1.cfgfiles[table1.cfgi]
	end
	table1.cfgsorted = {}
	table1.cfgi = 2
	table1.cfgname = table1.configlistnames[table1.cfgi]
	while table1.cfgname do
		table.insert(table1.cfgsorted, table1.cfgname)
		table1.cfgi += 1
		table1.cfgname = table1.configlistnames[table1.cfgi]
	end
	table.sort(table1.cfgsorted)
	table1.configlistnames = {"(defaults)"}
	table1.cfgi = 1
	table1.cfgname = table1.cfgsorted[table1.cfgi]
	while table1.cfgname do
		table.insert(table1.configlistnames, table1.cfgname)
		table1.cfgi += 1
		table1.cfgname = table1.cfgsorted[table1.cfgi]
	end
	return table1.configlistnames
end
