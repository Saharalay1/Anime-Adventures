	if not table1.songInstance then return end
	if table1.songEndedConnection then
		table1.songEndedConnection:Disconnect()
		table1.songEndedConnection = nil
	end
	table1.songEndedConnection = table1.songInstance.Ended:Connect(function()
		table1.songInstance = nil
