table1.bindplayerhumanoidlifecycle = function(p, character)
	if not p or not character then return end
	if table1.playerlifecyclehumconns[p] then
		table1.playerlifecyclehumconns[p]:Disconnect()
		table1.playerlifecyclehumconns[p] = nil
	end
	table1.lifecyclehum = character:FindFirstChildOfClass("Humanoid")
	if not table1.lifecyclehum then
		table1.lifecyclehum = character:WaitForChild("Humanoid", 3)
	end
	if not table1.lifecyclehum then return end
	table1.playerlifecyclehumconns[p] = table1.lifecyclehum.Died:Connect(function()
		if table1.updateplayercache then table1.updateplayercache(p) end
		table1.esplistdirty = true
		if table1.areyoufuckingabletouseesp then
			if table1.espplayerrecords and table1.espplayerrecords[p] and table1.playesspppppupdaateee then
