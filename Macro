table1.updateskeletalforplayer = function(targetPlayer, record, camera)
	if not record then
		table1.destroyskeletalstuff(targetPlayer)
		return
	end
	if not table1.areyoufuckingabletouseesp or not record.character or not record.root or not record.root.Parent then
		table1.destroyskeletalstuff(targetPlayer)
		record.skeletalActive = false
		record.skeletalBonesActive = false
		return
	end
	local bonesonnn = false
	local jointsonnn = false
	if table1.skeletalesp then
		bonesonnn = table1.skeletalesp:GetAttribute("Selected1") == true
		jointsonnn = table1.skeletalesp:GetAttribute("Selected2") == true
	end
	if (not bonesonnn and not jointsonnn) or not table1.isesptargetallowed(targetPlayer, "Skeleton") then
		table1.destroyskeletalstuff(targetPlayer)
		record.skeletalActive = false
		record.skeletalBonesActive = false
		return
	end
	record.skeletalActive = true
	record.skeletalBonesActive = bonesonnn
	local char = record.character
	if record.skeletalPartsCharacter ~= char or not record.skeletalParts then
		record.skeletalParts = table1.getskeletalparts(char)
		record.skeletalPartsCharacter = char
	end
	local parts = record.skeletalParts
	local baseBone = table1.getespcolor(table1.skeletalespcolor, Color3.fromRGB(255, 0, 0), table1.skeletalcolorvalues)
	local baseJoint = table1.getespcolor(table1.skeletalespjointcolor, Color3.fromRGB(150, 25, 25), table1.skeletaljointcolorvalues)
	-- use pure custom color unless team/friend color overrides are active
	local boneColor = table1.getesptargetcolor(targetPlayer, baseBone)
	local jointColor = table1.getesptargetcolor(targetPlayer, baseJoint)
	local boneTrans = table1.getesptransparency(table1.skeletalesptransparency, 0)
	local jointTrans = table1.getesptransparency(table1.skeletaljointtransparency, 0)
	local boneThick = math.clamp(tonumber(table1.skeletalespthickness.Text) or 5, 0.5, 20)
	local jointRadius = math.clamp(tonumber(table1.skeletalespjoinradius.Text) or 1, 0.5, 20)
	if not table1.skeletallines[targetPlayer] then
		table1.skeletallines[targetPlayer] = {}
	end
	if not table1.skeletaljoints[targetPlayer] then
		table1.skeletaljoints[targetPlayer] = {}
	end
	local lines = table1.skeletallines[targetPlayer]
	local joints = table1.skeletaljoints[targetPlayer]
	if bonesonnn then
		for i, pair in ipairs(table1.skeletalbones) do
			local a = parts[pair[1]]
			local b = parts[pair[2]]
			local line = lines[i]
			if a and b and a.Parent and b.Parent then
				local startpos = a.Position
				local endpos = b.Position
				local delta = endpos - startpos
				local len = delta.Magnitude
				if len > 0.05 then
					if not table1.instalivee(line) then
						table1.safedestroyy(line)
						line = table1.makelinehandlee(a)
						lines[i] = line
					end
					line.Adornee = a
					local relative = a.CFrame:PointToObjectSpace(endpos)
					line.CFrame = CFrame.new(Vector3.zero, relative)
					line.Length = relative.Magnitude
					line.Thickness = boneThick
					line.Color3 = Color3.new(boneColor.R, boneColor.G, boneColor.B) -- force pure color, no greying
					line.Transparency = boneTrans
					line.AlwaysOnTop = true
					line.Visible = true
					line.ZIndex = 10
				else
					if table1.instalivee(line) then
						line.Visible = false
					end
				end
			else
				if table1.instalivee(line) then
					line.Visible = false
				end
			end
		end
	else
		for _, line in pairs(lines) do
			if table1.instalivee(line) then
				line.Visible = false
			end
		end
	end
	if jointsonnn then
		for name, part in pairs(parts) do
			local joint = joints[name]
			if part and part.Parent then
				if not table1.instalivee(joint) then
					table1.safedestroyy(joint)
					joint = table1.makespherehandlee(part)
					joints[name] = joint
				end
				joint.Adornee = part
				joint.Radius = math.clamp(jointRadius * 0.04, 0.015, 0.5)
				joint.Color3 = jointColor
				joint.Transparency = jointTrans
				joint.AlwaysOnTop = true
				joint.Visible = true
				joint.ZIndex = 10
			else
				if table1.instalivee(joint) then
					joint.Visible = false
				end
			end
		end
	else
		for _, joint in pairs(joints) do
			if table1.instalivee(joint) then
				joint.Visible = false
			end
		end
	end
end
