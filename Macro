		state.actiondragbox = state.actionmkbtn("Button Drag: off")
		state.actiondragbox.Activated:Connect(function()
			if state.actiondrag == "on" then
				state.actiondrag = "off"
			else
				state.actiondrag = "on"
			end
			state.actiondragbox.Text = "Button Drag: " .. state.actiondrag
		end)
		state.actionshapebox = state.actionmkbtn("Shape: 1")
		state.actionshapebox.Activated:Connect(function()
			state.actionshape = state.actionshape + 1
			if state.actionshape > 3 then
				state.actionshape = 1
			end
			state.actionshapebox.Text = "Shape: " .. tostring(state.actionshape)
			if table1.syncactionbuttonfor then
				table1.syncactionbuttonfor(main)
			end
		end)
		state.actionscalebox = state.actionmktxt("scale", state.actionscale, true)
		state.actionscalebox:SetAttribute("Numberlocked", false)
		state.actionscalebox:SetAttribute("preventchange", true)
		state.actionscalebox:GetPropertyChangedSignal("Text"):Connect(function()
			state.actionscale = state.actionscalebox.Text
			if table1.syncactionbuttonfor then
				table1.syncactionbuttonfor(main)
			end
		end)
		state.actiontextbox = state.actionmktxt("Action Text", state.actiontext, false)
		state.actiontextbox:SetAttribute("Numberlocked", false)
		state.actiontextbox:SetAttribute("preventchange", true)
		state.actiontextbox:GetPropertyChangedSignal("Text"):Connect(function()
			state.actiontext = state.actiontextbox.Text
			if table1.syncactionbuttonfor then
				table1.syncactionbuttonfor(main)
			end
			if table1.refreshpcactionsdisplay then table1.refreshpcactionsdisplay() end
		end)
		if table1.syncactionbuttonfor then
			table1.syncactionbuttonfor(main)
		end
		if table1.createactionstatusdot then table1.createactionstatusdot(main) end
	end



	state.fold.Activated:Connect(function()
		if not state.folded then
			state.folded = true

			if modeType == 2 or modeType == 4 then
				if state.dropdownTween then
					state.dropdownTween:Cancel()
					state.dropdownTween = nil
				end

				if state.dropdownMainTween then
					state.dropdownMainTween:Cancel()
					state.dropdownMainTween = nil
				end

				state.dropdownOpen = false
				state.updateDropdownText()

				if state.dropdown then
					state.dropdown.Visible = false
				end

				main.ClipsDescendants = true
			end

			if state.modeArea then
				state.modeArea.Visible = false
			end

			if state.selector then
				state.selector.Visible = false
			end

			for _, valueBox in ipairs(state.valueBoxes) do
				valueBox.Visible = false
			end
			for _, valueBox in ipairs(state.actionboxes or {}) do
				valueBox.Visible = false
			end

			state.fold.Text = "+"
			main:SetAttribute("LayoutHeight", state.foldedHeight)

			table1.tween1(main, table1.maintoggletransition, {
				Size = UDim2.new(0, state.toggleWidth, 0, state.foldedHeight),
			})

			state.relayout()
			return
		end

		state.folded = false
		state.fold.Text = "-"

		if state.modeArea then
			state.modeArea.Visible = true
		end

		if state.selector then
			state.selector.Visible = true
		end

		for _, valueBox in ipairs(state.valueBoxes) do
			valueBox.Visible = true
		end
		for _, valueBox in ipairs(state.actionboxes or {}) do
			valueBox.Visible = true
		end

		if modeType == 2 or modeType == 4 then
			state.dropdownOpen = false
			state.updateDropdownText()

			if state.dropdown then
				state.dropdown.Visible = false
			end

			main.ClipsDescendants = true
		end

		main:SetAttribute("LayoutHeight", state.normalHeight)

		table1.tween1(main, table1.maintoggletransition, {
			Size = UDim2.new(0, state.toggleWidth, 0, state.normalHeight),
		})

		state.relayout()
	end)

	state.relayout = function()
		state.toggles = {}
		state.children = parent:GetChildren()
		state.loopIndex = 1
		state.child = state.children[state.loopIndex]
		while state.child do
			if state.child:GetAttribute("Maintoggle") then table.insert(state.toggles, state.child) end
			state.loopIndex += 1
			state.child = state.children[state.loopIndex]
		end

		table.sort(state.toggles, function(a, b)
			return (a:GetAttribute("LayoutOrder") or 0)
				< (b:GetAttribute("LayoutOrder") or 0)
		end)

		state.first = state.toggles[1]
		state.baseX = state.first and state.first.Position.X.Offset or 10
		state.baseY = state.first and state.first.Position.Y.Offset or 10
		state.spacing = 10 * state.scale
		state.rightX = state.baseX + state.toggleWidth + state.spacing
		state.leftY = state.baseY
		state.rightY = state.baseY

		for i = 1, #state.toggles do
			local child = state.toggles[i]
			local height = child:GetAttribute("LayoutHeight") or state.normalHeight
			local targetX, targetY

			if i % 2 == 1 then
				targetX = state.baseX
				targetY = state.leftY
				state.leftY += height + state.spacing
			else
				targetX = state.rightX
				targetY = state.rightY
				state.rightY += height + state.spacing
			end

			table1.tween1(child, table1.tabtransition, {
				Position = UDim2.new(0, targetX, 0, targetY),
			})
		end
	end

	state.relayout()

	main.Destroying:Connect(function()
		local currentState = table1.maintoggleState[main]
		if currentState then
			if currentState.modechanged then
				currentState.modechanged:Destroy()
			end
			if currentState.actionbutton then
				currentState.actionbutton:Destroy()
			end
			if table1.destroyactionbuttonfor then
				table1.destroyactionbuttonfor(main)
			end
			table1.maintoggleState[main] = nil
		end
	end)

	if state.actionflag == 1 and state.actionbutton then
		return main, state.modechanged.Event, state.actionbutton.Event, table.unpack(state.valueBoxes)
	end
	return main, state.modechanged.Event, table.unpack(state.valueBoxes)
end
