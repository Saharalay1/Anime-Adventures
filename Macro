	main:SetAttribute("ActionActive", on == true)
	if table1.tpst.actionstatusdot then
		table1.tpst.actionstatusdot.BackgroundColor3 = on and table1.on1 or table1.off1
	end
	if table1.updateactionstatusdot then
		table1.updateactionstatusdot(main)
	end
	if table1.tpst.actionstatusdot then
		table1.tpst.actionstatusdot.BackgroundColor3 = on and table1.on1 or table1.off1
	end
end

