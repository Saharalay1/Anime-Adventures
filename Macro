table1.songendedhandle = function()
	local mode = table1.loopmusicmodeorsmthlikethat or 0

	if mode == 1 then
		table1.playsong(table1.getrandomsong("avoidlast"))

	elseif mode == 2 then
		table1.playsong(table1.getrandomsong("avoidallplayed"))

	elseif mode >= 3 and mode <= 5 then
		local selected = table1.selectedsongs or {}

		if #selected == 0 then
			return
		end

		local choice
		local last = table1.lastPlayedSong

		if mode == 3 then
			local index = table.find(selected, last)

			if index then
				index = index % #selected + 1
			else
				index = 1
			end

			choice = selected[index]

		elseif mode == 4 then
			local available = {}

			for _, song in ipairs(selected) do
				if song ~= last then
					table.insert(available, song)
				end
			end

			if #available == 0 then
				available = selected
			end

			choice = available[math.random(1, #available)]

		elseif mode == 5 then
			table1.playedSelectedSongs = table1.playedSelectedSongs or {}

			if last and table.find(selected, last) then
				table1.playedSelectedSongs[last] = true
			end

			local available = {}

			for _, song in ipairs(selected) do
				if not table1.playedSelectedSongs[song] then
					table.insert(available, song)
				end
			end

			if #available == 0 then
				table1.playedSelectedSongs = {}

				for _, song in ipairs(selected) do
					if song ~= last or #selected == 1 then
						table.insert(available, song)
					end
				end
			end

			choice = available[math.random(1, #available)]
			table1.playedSelectedSongs[choice] = true
		end

		if choice then
			table1.playsong(choice)
		end
	end
