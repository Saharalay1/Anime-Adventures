		if table1.eikey == "skeleton" then return table1.eiFlags.skeleton == true end
		if table1.eikey == "chams" then return table1.eiFlags.chams == true end
		if table1.eikey == "infographic" then return table1.eiFlags.infographic == true end
		return true
	end
	table1.esphaspeople = table1.esppeopleselected and next(table1.esppeopleselected) ~= nil
	table1.espispeople = table1.esphaspeople and (table1.esppeopleselected[targetPlayer.Name] or table1.esppeopleselected[targetPlayer.DisplayName])
