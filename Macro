	end
	if data["__lastshiftlockmode"] ~= nil then
		table1.lastshiftlockmode = tonumber(data["__lastshiftlockmode"]) or 1
	end
	table1.cfgmain = next(table1.maintoggleState)
	while table1.cfgmain do
		table1.cfgstate = table1.maintoggleState[table1.cfgmain]
		if table1.cfgstate and table1.cfgstate.actionflag == 1 and table1.cfgstate.title and table1.actionbuttonmap and table1.actionbuttonmap[table1.cfgmain] and table1.actionbuttonmap[table1.cfgmain].button then
