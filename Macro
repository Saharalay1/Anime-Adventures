	record.boxFrame.Visible = showBox
	record.boxFrame.Position = UDim2.fromOffset(left, top)
	record.boxFrame.Size = UDim2.fromOffset(boxWidth, boxHeight)
	record.boxStroke.Thickness = math.clamp(tonumber(table1.d2boxxespthickness.Text) or 1, 1, 10)
	record.boxStroke.Transparency = table1.getesptransparency(table1.d2boxxesptransparency, 0)
	record.boxStroke.Color = record.box2DColor or table1.purple
	if showUsername and nameY then
		record.nameLabel.TextColor3 = record.infoNameColor or table1.white
		placeLabel(record.nameLabel, record.nameOutlineLabels, nameY, targetPlayer.Name, record.infoNameColor or table1.white)
	else
