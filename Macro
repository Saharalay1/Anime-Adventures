table1.applyrigesp = function()
	if not table1.rigmodel or not table1.righrp or not table1.rigespoverlay then return end
	table1.clearrigespvisuals()
	table1.rigchamsoutline = table1.chams and table1.chams:GetAttribute("Selected1") == true
	table1.rigchamsfill = table1.chams and table1.chams:GetAttribute("Selected2") == true
	if table1.rigchamsoutline or table1.rigchamsfill then
		table1.rigfillcolor = table1.getespcolor(table1.chamsfillcolor, table1.purple, table1.chamscolorvalues)
		table1.rigoutlinecolor = table1.getespcolor(table1.chamsoutlinecolor, table1.white, table1.chamscolorvalues)
		table1.rigfilltrans = table1.rigchamsfill and table1.getesptransparency(table1.chamsfilltransparency, 0.75) or 1
		table1.rigoutlinetrans = table1.rigchamsoutline and table1.getesptransparency(table1.chamsoutlinetransparency, 0) or 1
		table1.rigoutlinethick = 2
		table1.rigoriginalcolors = {}
		-- Highlight is unreliable inside ViewportFrame/WorldModel, so use screen-space edge overlays
		-- (always visible through the test wall) + optional part recolor for fill
		for _, p in ipairs(table1.rigmodel:GetDescendants()) do
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Name ~= "Viz3DBounds" and p.Name ~= "VizWall" and p.Transparency < 1 then
				table1.rigoriginalcolors[p] = {Color = p.Color, Material = p.Material, Transparency = p.Transparency}
				if table1.rigchamsfill then
					p.Color = table1.rigfillcolor
					p.Material = Enum.Material.SmoothPlastic
					p.Transparency = table1.rigfilltrans
				end
				if table1.rigchamsoutline then
					local half = p.Size * 0.5
					for _, edge in ipairs(table1.rigpreviewedges) do
						local a = Vector3.new(edge[1].X * half.X, edge[1].Y * half.Y, edge[1].Z * half.Z)
