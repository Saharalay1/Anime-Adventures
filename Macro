table1.flying = function(mode)
	table1.resolveflytarget()
	table1.camera = table1.Workspace.CurrentCamera
	if not table1.flytargetpart or not table1.camera then return end
	table1.flyhum = table1.char and table1.char:FindFirstChildOfClass("Humanoid") or table1.humanoid
	table1.movedirection = (table1.flyhum and table1.flyhum.MoveDirection) or Vector3.zero
	table1.flycameraCFrame = table1.camera:GetRenderCFrame()
	table1.flycameralookk = table1.flycameraCFrame.LookVector
	table1.flycamerarightt = table1.flycameraCFrame.RightVector
	table1.flycameraup = table1.flycameraCFrame.UpVector
	table1.flyDirection = Vector3.zero
	table1.flyforward = 0
	table1.flyright = 0
	table1.flyspeed = tonumber(table1.flyvalue.Text) or 50
	if mode == 5 then
		if not table1.flybodyvelocity or not table1.flybodyvelocity.Parent or not table1.flypart or not table1.flypart.Parent then
			table1.prepareflight(5)
			if not table1.flybodyvelocity then return end
		end
		if table1.flyweld and table1.flyweld.Part1 ~= table1.flytargetpart then
			table1.flyweld.Part1 = table1.flytargetpart
		end
		table1.flyvertical = (table1.flyq or 0) + (table1.flye or 0)
		table1.flymv = Vector3.zero
		if table1.movedirection.Magnitude > 0.05 then
			table1.flyflatLook = Vector3.new(table1.flycameralookk.X, 0, table1.flycameralookk.Z)
			table1.flyflatRight = Vector3.new(table1.flycamerarightt.X, 0, table1.flycamerarightt.Z)
			if table1.flyflatLook.Magnitude > 0.001 then table1.flyflatLook = table1.flyflatLook.Unit end
			if table1.flyflatRight.Magnitude > 0.001 then table1.flyflatRight = table1.flyflatRight.Unit end
			table1.flyforward = table1.movedirection:Dot(table1.flyflatLook)
			table1.flyright = table1.movedirection:Dot(table1.flyflatRight)
			table1.flymv = Vector3.new(table1.flyright, 0, -table1.flyforward)
		end
		table1.flysavedcamcf = table1.flycameraCFrame
		table1.flybodyvelocity.Velocity = (table1.flycameralookk * -table1.flymv.Z * table1.flyspeed)
			+ (table1.flycamerarightt * table1.flymv.X * table1.flyspeed)
			+ (table1.flycameraup * table1.flyvertical * table1.flyspeed)
		if table1.flybodygyro and table1.flybodygyro.Parent then
			table1.flybodygyro.CFrame = table1.flysavedcamcf
		end
		if table1.flyhum and table1.camera.CameraSubject ~= table1.flyhum then
			table1.flysub = table1.camera.CameraSubject
			if table1.flysub and (table1.flysub:IsA("VehicleSeat") or table1.flysub:IsA("Seat") or table1.flysub.Name == "DriveSeat" or (table1.flyvehicle and table1.flysub:IsDescendantOf(table1.flyvehicle))) then
				table1.camera.CameraSubject = table1.flyhum
			end
		end
		table1.camera.CFrame = table1.flysavedcamcf
		return
	end
	if table1.movedirection.Magnitude > 0.05 then
		table1.flyflatLook = Vector3.new(table1.flycameralookk.X, 0, table1.flycameralookk.Z)
		table1.flyflatRight = Vector3.new(table1.flycamerarightt.X, 0, table1.flycamerarightt.Z)
		if table1.flyflatLook.Magnitude > 0.001 then
			table1.flyflatLook = table1.flyflatLook.Unit
		else
			table1.flyflatLook = Vector3.new(table1.flytargetpart.CFrame.LookVector.X, 0, table1.flytargetpart.CFrame.LookVector.Z)
			if table1.flyflatLook.Magnitude > 0.001 then table1.flyflatLook = table1.flyflatLook.Unit end
		end
		if table1.flyflatRight.Magnitude > 0.001 then table1.flyflatRight = table1.flyflatRight.Unit end
		table1.flyforward = table1.movedirection:Dot(table1.flyflatLook)
		table1.flyright = table1.movedirection:Dot(table1.flyflatRight)
		table1.flyDirection = table1.flycameralookk * table1.flyforward + table1.flyflatRight * table1.flyright
		if table1.flyDirection.Magnitude > 0.001 then table1.flyDirection = table1.flyDirection.Unit else table1.flyDirection = Vector3.zero end
	end
	if mode == 2 then
		table1.flynewpositionn = table1.flytargetpart.Position
		if table1.flyDirection.Magnitude > 0 then table1.flynewpositionn += table1.flyDirection * (table1.flyspeed / 10) end
		table1.flytargetpart.AssemblyLinearVelocity = Vector3.zero
		table1.flytargetpart.AssemblyAngularVelocity = Vector3.zero
		table1.flytargetpart.CFrame = CFrame.lookAt(table1.flynewpositionn, table1.flynewpositionn + table1.flycameralookk)
	elseif mode == 3 then
		if not table1.flylinearvelocity or not table1.flylinearvelocity.Parent then
			table1.prepareflight(3)
			if not table1.flylinearvelocity then return end
		end
		if table1.flyDirection.Magnitude > 0 then
			table1.flylinearvelocity.VectorVelocity = table1.flyDirection * table1.flyspeed
		else
			table1.flylinearvelocity.VectorVelocity = Vector3.zero
			table1.flytargetpart.AssemblyLinearVelocity = Vector3.zero
			table1.flytargetpart.AssemblyAngularVelocity = Vector3.zero
		end
		if table1.flyalignorientation then
			table1.flyalignorientation.CFrame = CFrame.lookAt(Vector3.zero, table1.flycameralookk)
		end
	elseif mode == 4 then
		if table1.flyDirection.Magnitude > 0 then
			table1.flytargetpart.AssemblyLinearVelocity = table1.flyDirection * table1.flyspeed
		else
			table1.flytargetpart.AssemblyLinearVelocity = Vector3.zero
			table1.flytargetpart.AssemblyAngularVelocity = Vector3.zero
		end
		if table1.flyalignorientation then
			table1.flyalignorientation.CFrame = CFrame.lookAt(Vector3.zero, table1.flycameralookk)
		end
	end
end

