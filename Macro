			highlight = nil
		end
		table1.chamstodeletecharacter = targetPlayer.Character
		if table1.chamstodeletecharacter then
			for _, chamstalehighlight in ipairs(table1.chamstodeletecharacter:GetChildren()) do
				if chamstalehighlight:IsA("Highlight") and chamstalehighlight.Name == "ChamsHighlight" then chamstalehighlight:Destroy() end
			end
		end
	end
	if not table1.areyoufuckingabletouseesp then
		removeHighlight()
		return
	end
	local character = targetPlayer.Character
	if not character or not character.Parent then
		removeHighlight()
		return
	end
	for _, chamstalehighlight in ipairs(character:GetChildren()) do
		if chamstalehighlight:IsA("Highlight") and chamstalehighlight.Name == "ChamsHighlight" and chamstalehighlight ~= highlight then chamstalehighlight:Destroy() end
	end
	local teamCheck, friendCheck, sameTeam, perTeamBlock, perFriendBlock = table1.getespeffectivechecks(targetPlayer, "Chams")
	local customTeamColor = table1.isespsettingenabled(2)
	local customFriendColor = table1.isespsettingenabled(3)
	local consistentTeamColor = table1.isespsettingenabled(4)
	local isFriend = table1.isespfriend(targetPlayer)
	if perTeamBlock or (perFriendBlock and isFriend) or (teamCheck and sameTeam) or (friendCheck and isFriend) then
		removeHighlight()
		return
	end
	if targetPlayer.Parent ~= table1.Players or targetPlayer.Character ~= character or not character.Parent then
		removeHighlight()
		return
	end
	if not highlight or highlight.Parent ~= character or highlight.Adornee ~= character then
		removeHighlight()
		highlight = Instance.new("Highlight")
		highlight.Name = "ChamsHighlight"
		highlight.Adornee = character
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = character
		table1.chamshighlights[targetPlayer] = highlight
	end
	local outlineEnabled = table1.chams:GetAttribute("Selected1") == true
	local fillEnabled = table1.chams:GetAttribute("Selected2") == true
	local fillColor = table1.getespcolor(table1.chamsfillcolor, table1.purple, table1.chamscolorvalues)
	local outlineColor = table1.getespcolor(table1.chamsoutlinecolor, table1.white, table1.chamscolorvalues)
