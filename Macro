table1.buildsortedplayerlabels = function()
	table1.splentries = {}
	for _,p in ipairs(table1.Players:GetPlayers()) do
		if p ~= table1.player then
			table1.splfriend = false
			if table1.isespfriend then
				table1.splfriend = table1.isespfriend(p) == true
			end
			table.insert(table1.splentries, {
				label = (p.DisplayName or p.Name) .. " (" .. p.Name .. ")",
				name = p.Name,
				friend = table1.splfriend
			})
		end
	end
	table.sort(table1.splentries, function(a, b)
		if a.friend ~= b.friend then
			return a.friend == true
		end
		return string.lower(a.label) < string.lower(b.label)
	end)
	table1.spllabels = {}
	table1.splfriends = {}
	for i,e in ipairs(table1.splentries) do
		table1.spllabels[i] = e.label
		table1.splfriends[i] = e.friend == true
	end
	return table1.spllabels, table1.splfriends
end

