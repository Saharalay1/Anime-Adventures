	if table1.playerclipplayerremovingconnection then table1.playerclipplayerremovingconnection:Disconnect() table1.playerclipplayerremovingconnection = nil end
	for player, connection in pairs(table1.playerclipcharacterconnections) do if connection then connection:Disconnect() end table1.playerclipcharacterconnections[player] = nil end
	for player, connection in pairs(table1.playerclipcharacterremovingconnections) do if connection then connection:Disconnect() end table1.playerclipcharacterremovingconnections[player] = nil end
	for player, connection in pairs(table1.playerclipdescendantconnections) do if connection then connection:Disconnect() end table1.playerclipdescendantconnections[player] = nil end
	for part, original in pairs(table1.playercliporiginall) do if part and original and part.Parent then part.CanCollide = original.cancollide end table1.playercliporiginall[part] = nil end
	table1.playerclipcharacters = {}
end

table1.foldAllMaintoggles = function()
	table1.foldStateKey = next(table1.maintoggleState)

	while table1.foldStateKey do
		table1.foldMain = table1.foldStateKey
		table1.foldState = table1.maintoggleState[table1.foldMain]

		if table1.foldState.fold and not table1.foldState.folded then
			table1.foldState.folded = true

			if table1.foldState.modeType == 2 or table1.foldState.modeType == 4 then
				if table1.foldState.dropdownTween then
					table1.foldState.dropdownTween:Cancel()
					table1.foldState.dropdownTween = nil
				end

				if table1.foldState.dropdownMainTween then
					table1.foldState.dropdownMainTween:Cancel()
					table1.foldState.dropdownMainTween = nil
				end

				table1.foldState.dropdownOpen = false
				table1.foldState.updateDropdownText()

				if table1.foldState.dropdown then
					table1.foldState.dropdown.Visible = false
				end

				table1.foldMain.ClipsDescendants = true
			end

			if table1.foldState.modeArea then
				table1.foldState.modeArea.Visible = false
			end

			if table1.foldState.selector then
				table1.foldState.selector.Visible = false
			end

			table1.foldState.loopIndex = 1
			table1.foldState.child = table1.foldState.valueBoxes[table1.foldState.loopIndex]

			while table1.foldState.child do
				table1.foldState.child.Visible = false
				table1.foldState.loopIndex += 1
				table1.foldState.child = table1.foldState.valueBoxes[table1.foldState.loopIndex]
			end

			table1.foldState.fold.Text = "+"
			table1.foldMain:SetAttribute("LayoutHeight", table1.foldState.foldedHeight)

			table1.tween1(table1.foldMain, table1.maintoggletransition, {
				Size = UDim2.new(0, table1.foldState.toggleWidth, 0, table1.foldState.foldedHeight)
			})

			table1.foldState.relayout()
		end

		table1.foldStateKey = next(table1.maintoggleState, table1.foldStateKey)
	end
end


