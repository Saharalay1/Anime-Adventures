table1.rebuildrigmodel = function()
	if not table1.rigworld then return end
	table1.clearrigespvisuals()
	if table1.rigwallpart then table1.rigwallpart:Destroy() table1.rigwallpart = nil end
	if table1.rigmodel then table1.rigmodel:Destroy() table1.rigmodel = nil end
	table1.rigpartmodel = nil
	table1.rigparts = nil
	table1.righrp = nil
	table1.righum = nil
	if table1.rigvistype == 1 then
		if table1.rigrigtype == 1 then
			table1.creater6rig()
		else
			table1.creater15rig()
		end
	else
		table1.rigmodel = Instance.new("Model")
		table1.rigmodel.Name = "VizAvatar"
		table1.rigchar = table1.player.Character
		if table1.rigchar then
			table1.rigwasarchivable = table1.rigchar.Archivable
			table1.rigchar.Archivable = true
			table1.rigfullclone = table1.rigchar:Clone()
			table1.rigchar.Archivable = table1.rigwasarchivable
			if table1.rigfullclone then
				for _,child in ipairs(table1.rigfullclone:GetChildren()) do
					if child:IsA("Script") or child:IsA("LocalScript") or child:IsA("ModuleScript") or child.Name == "Animate" then
						child:Destroy()
					else
						child.Parent = table1.rigmodel
					end
				end
				table1.rigfullclone:Destroy()
			end
			table1.righrp = table1.rigmodel:FindFirstChild("HumanoidRootPart") or table1.rigmodel:FindFirstChild("Torso") or table1.rigmodel.PrimaryPart
			table1.righum = table1.rigmodel:FindFirstChildOfClass("Humanoid")
			if table1.righum then
				table1.righum.MaxHealth = 1000
				table1.righum.Health = table1.rigvishealth
				table1.righum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end
			if table1.righrp then
				table1.rigmodel.PrimaryPart = table1.righrp
				table1.rigorigin = table1.righrp.CFrame
				for _,p in ipairs(table1.rigmodel:GetDescendants()) do
					if p:IsA("BasePart") then
						p.Anchored = true
						p.CanCollide = false
						p.AssemblyLinearVelocity = Vector3.zero
						p.AssemblyAngularVelocity = Vector3.zero
						p.CFrame = table1.rigorigin:ToObjectSpace(p.CFrame)
					end
				end
			end
		end
		if not table1.righrp then
			table1.rigmodel:Destroy()
			table1.creater6rig()
		end
	end
	if table1.rigmodel then
		table1.rigmodel.Parent = table1.rigworld
		for _,p in ipairs(table1.rigmodel:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Anchored = true
				p.CanCollide = false
			end
		end
	end
	table1.updaterigwall()
	table1.updaterigcamera()
	table1.applyrigesp()
end

