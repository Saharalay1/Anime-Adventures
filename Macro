table1.collectconfigdata = function()
	table1.configdata = {}
	table1.cfgmain = next(table1.maintoggleState)
	while table1.cfgmain do
		table1.cfgstate = table1.maintoggleState[table1.cfgmain]
		if table1.cfgmain.Parent and table1.cfgstate and table1.cfgstate.title then
			table1.cfgtitle = table1.cfgstate.title.Text
			if table1.cfgtitle ~= "Configs Selection" and table1.cfgtitle ~= "Configurations" and table1.cfgtitle ~= "Autoload" and table1.cfgtitle ~= "Autoload Enabled" and table1.cfgtitle ~= "Emergency" and table1.cfgtitle ~= "Target Specific People" and table1.cfgmain:GetAttribute("NoConfig") ~= true and not string.find(table1.cfgtitle, "^ESP Individual:") then
				table1.cfgentry = {}
				table1.cfgentry.modetype = table1.cfgstate.modeType
				table1.cfgentry.mode = table1.cfgmain:GetAttribute("Mode") or 0
				table1.cfgentry.selected = {}
				table1.cfgentry.values = {}
				if table1.cfgstate.modeType == 1 or table1.cfgstate.modeType == 2 then
					table1.cfgi = 1
					while table1.cfgi <= table1.cfgstate.modecount do
						table1.cfgentry.selected[tostring(table1.cfgi)] = table1.cfgmain:GetAttribute("Selected" .. table1.cfgi) == true
						table1.cfgi += 1
					end
					if table1.cfgtitle == "Specific Teams Filter" and table1.cfgstate.dropdownButtons then
						table1.cfgentry.teamnames = {}
						table1.cfgi = 1
						while table1.cfgi <= table1.cfgstate.modecount do
							table1.cfgbtn = table1.cfgstate.dropdownButtons[table1.cfgi]
							if table1.cfgbtn and table1.cfgentry.selected[tostring(table1.cfgi)] then
								table1.cfgentry.teamnames[table1.cfgbtn.Text] = true
							end
							table1.cfgi += 1
						end
					end
				end
				table1.cfgi = 1
				table1.cfgbox = (table1.cfgstate.valueBoxes or {})[table1.cfgi]
				while table1.cfgbox do
					table1.cfgentry.values[tostring(table1.cfgi)] = table1.cfgbox.Text
					table1.cfgi += 1
					table1.cfgbox = (table1.cfgstate.valueBoxes or {})[table1.cfgi]
				end
				if table1.cfgstate.actionflag == 1 then
					table1.cfgentry.action = {
						on = table1.cfgstate.actionon or "off",
						drag = table1.cfgstate.actiondrag or "off",
						shape = tonumber(table1.cfgstate.actionshape) or 1,
						scale = tostring(table1.cfgstate.actionscale or "1"),
						text = table1.cfgstate.actiontext or "Button",
						keybind = table1.cfgstate.actionkeybind or "",
						hold = table1.cfgstate.actionhold or "press",
						active = table1.cfgstate.actionactive == true or table1.cfgmain:GetAttribute("ActionActive") == true,
					}
					if table1.actionbuttonmap and table1.actionbuttonmap[table1.cfgmain] and table1.actionbuttonmap[table1.cfgmain].button and table1.actionbuttonmap[table1.cfgmain].button.Parent then
						table1.cfgentry.action.x = table1.actionbuttonmap[table1.cfgmain].button.Position.X.Offset
						table1.cfgentry.action.y = table1.actionbuttonmap[table1.cfgmain].button.Position.Y.Offset
					elseif table1.actionbuttonpositions and type(table1.actionbuttonpositions[table1.cfgtitle]) == "table" then
						table1.cfgentry.action.x = tonumber(table1.actionbuttonpositions[table1.cfgtitle].x)
						table1.cfgentry.action.y = tonumber(table1.actionbuttonpositions[table1.cfgtitle].y)
					end
				end
				if table1.cfgtitle == "Information Display" then
					if table1.infoframe and table1.infoframe.Parent then
						table1.cfgentry.infox = table1.infoframe.Position.X.Offset
						table1.cfgentry.infoy = table1.infoframe.Position.Y.Offset
					elseif table1.infopos then
						table1.cfgentry.infox = table1.infopos.X.Offset
						table1.cfgentry.infoy = table1.infopos.Y.Offset
					end
				end
				if table1.cfgtitle == "Music Settings" or string.find(table1.cfgtitle, "Playlist") then

					table1.cfgentry.playlist = {}
					table1.cfgsongs = table1.selectedsongs or {}
					table1.cfgi = 1
					table1.cfgsong = table1.cfgsongs[table1.cfgi]
					while table1.cfgsong do
						table1.cfgexists = false
						table1.cfgchecks = table1.songlist()
						table1.cfgj = 1
						table1.cfgcheck = table1.cfgchecks[table1.cfgj]
						while table1.cfgcheck do
							if table1.cfgcheck == table1.cfgsong then
								table1.cfgexists = true
								break
							end
							table1.cfgj += 1
							table1.cfgcheck = table1.cfgchecks[table1.cfgj]
						end
						if table1.cfgexists then
							table.insert(table1.cfgentry.playlist, table1.cfgsong)
						end
						table1.cfgi += 1
