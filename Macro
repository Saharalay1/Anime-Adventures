				table1.corehasspecteams = true
			elseif next(table1.corespecteams) then
				table1.corehasspecteams = true
			end
		end
	end
	table1.corepass = true
	if table1.corehasspecteams then
		table1.coreteamok = false
		if plr.Team then
			if type(table1.corespecteams) == "table" and table1.corespecteams[1] ~= nil then
				table1.coreteamok = table.find(table1.corespecteams, plr.Team.Name) ~= nil
			else
				table1.coreteamok = table1.corespecteams[plr.Team.Name] == true
			end
		end
		table1.corepass = table1.coreteamok
	else
		table1.corefilter = filtermode or 1
		if table1.corefilter == 4 or table1.corefilter == "none" then
			table1.corepass = false
		elseif table1.corefilter == 2 or table1.corefilter == "team" then
			if not table1.player.Team or not plr.Team or plr.Team ~= table1.player.Team then table1.corepass = false end
		elseif table1.corefilter == 3 or table1.corefilter == "enemies" then
			if table1.player.Team and plr.Team and plr.Team == table1.player.Team then table1.corepass = false end
