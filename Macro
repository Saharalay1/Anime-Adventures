table1.projectrigoverlayline = function(line, startpos, endpos)
	if not line or not startpos or not endpos then return end
	table1.rigoverlaystart, table1.rigoverlaystartvisible = table1.rigworldtoviewport(startpos)
	table1.rigoverlayend, table1.rigoverlayendvisible = table1.rigworldtoviewport(endpos)
	if not table1.rigoverlaystartvisible or not table1.rigoverlayendvisible then
		line.Visible = false
		return
	end
	table1.rigoverlaydelta = table1.rigoverlayend - table1.rigoverlaystart
	line.Visible = true
	line.Position = UDim2.fromOffset((table1.rigoverlaystart.X + table1.rigoverlayend.X) * 0.5, (table1.rigoverlaystart.Y + table1.rigoverlayend.Y) * 0.5)
	line.Size = UDim2.fromOffset(math.max(1, table1.rigoverlaydelta.Magnitude), math.max(0.5, line.Size.Y.Offset))
	line.Rotation = math.deg(math.atan2(table1.rigoverlaydelta.Y, table1.rigoverlaydelta.X))
end

table1.updaterigoverlays = function()
	if not table1.rigmodel or not table1.rigviewport or not table1.rigespoverlay then return end
	for _, data in ipairs(table1.rigchamlines) do
		if data.part and data.part.Parent then
			table1.projectrigoverlayline(data.frame, data.part.CFrame:PointToWorldSpace(data.a), data.part.CFrame:PointToWorldSpace(data.b))
		else
			data.frame.Visible = false
		end
	end
	for index, line in pairs(table1.rigskelLines) do
		table1.rigskelpair = table1.rigskelpartpairs[index]
		if table1.rigskelpair and table1.rigskelpair.a and table1.rigskelpair.b and table1.rigskelpair.a.Parent and table1.rigskelpair.b.Parent then
			table1.projectrigoverlayline(line, table1.rigskelpair.a.Position, table1.rigskelpair.b.Position)
		else
			line.Visible = false
		end
	end
	for name, joint in pairs(table1.rigskeljoints) do
		table1.rigjointpart = table1.rigskeljointparts[name]
		if table1.rigjointpart and table1.rigjointpart.Parent then
			table1.rigjointpoint, table1.rigjointvisible = table1.rigworldtoviewport(table1.rigjointpart.Position)
			joint.Visible = table1.rigjointvisible
			if table1.rigjointvisible then
				joint.Position = UDim2.fromOffset(table1.rigjointpoint.X, table1.rigjointpoint.Y)
			end
		else
			joint.Visible = false
		end
	end
	for _, data in ipairs(table1.rigbox3dedges) do
		if data.part and data.part.Parent then
			table1.projectrigoverlayline(data.frame, data.part.CFrame:PointToWorldSpace(data.a), data.part.CFrame:PointToWorldSpace(data.b))
		else
			data.frame.Visible = false
		end
	end
end

