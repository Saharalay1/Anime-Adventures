					table1.selectedsongs = {}
					table1.cfgi = 1
					table1.cfgsong = table1.cfgentry.playlist[table1.cfgi]
					while table1.cfgsong do
						table.insert(table1.selectedsongs, table1.cfgsong)
						table1.cfgi += 1
						table1.cfgsong = table1.cfgentry.playlist[table1.cfgi]
					end
				end
				if table1.cfgstate.modechanged then
					if table1.cfgstate.modeType == 1 or table1.cfgstate.modeType == 2 then
						table1.cfgi = 1
						while table1.cfgi <= (table1.cfgstate.modecount or 0) do
							table1.cfgsel = table1.cfgmain:GetAttribute("Selected" .. table1.cfgi) == true
							table1.cfgstate.modechanged:Fire(table1.cfgi, table1.cfgsel)
							table1.cfgi += 1
						end
