table1.selecttab = function(button, page)
	if table1.selectedtab == button then
		return
	end

	local transitionTime = table1.tabtransition

	if table1.selectedtab then
		local distance = math.abs(button.Position.Y.Offset - table1.selectedtab.Position.Y.Offset)
		local multiplier = 3 - 2 ^ (1 - distance / 33)
		transitionTime = table1.tabtransition * multiplier

		table1.tween1(table1.selectedtab, table1.tabtransition, {
			BackgroundColor3 = table1.tabinactive,
			BackgroundTransparency = 0.25
		})
	end

	table1.selectChildren = table1.frame:GetChildren()
	table1.selectChildIndex = 1
	table1.selectChild = table1.selectChildren[table1.selectChildIndex]
	while table1.selectChild do
		if table1.selectChild:GetAttribute("TabPage") then table1.selectChild.Visible = false end
		table1.selectChildIndex += 1
		table1.selectChild = table1.selectChildren[table1.selectChildIndex]
	end

	table1.selectedtab = button

	table1.tween1(button, table1.tabtransition, {
		BackgroundColor3 = table1.selectedtabcolor,
		BackgroundTransparency = 0
	})

	table1.tween1(table1.tabselector, transitionTime, {
		Position = UDim2.new(0, button.Position.X.Offset - 2, 0, button.Position.Y.Offset - 2)
	})

	page.Visible = true
end
 
