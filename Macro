table1.setnoclipp = function(character)
	character = character or table1.character or table1.player.Character
	if not character then return end
	if table1.noclipconnection then table1.noclipconnection:Disconnect() table1.noclipconnection = nil end
	if table1.noclipremovingconnection then table1.noclipremovingconnection:Disconnect() table1.noclipremovingconnection = nil end
	if table1.eznoclipenforcing then table1.eznoclipenforcing:Disconnect() table1.eznoclipenforcing = nil end
	table1.noclipcharacter = character
	table1.noclipdescendants = character:GetDescendants()
	table1.noclipdescendantset = {}
	for _, thing in ipairs(table1.noclipdescendants) do
		table1.noclipdescendantset[thing] = true
		if thing:IsA("BasePart") then thing.CanCollide = false end
	end
	table1.noclipconnection = character.DescendantAdded:Connect(function(thing)
		if not table1.noclipp or table1.noclipcharacter ~= character then return end
		if not table1.noclipdescendantset[thing] then
			table1.noclipdescendantset[thing] = true
			table.insert(table1.noclipdescendants, thing)
		end
		if thing:IsA("BasePart") then
			if table1.owncollisionoriginal[thing] == nil then table1.owncollisionoriginal[thing] = thing.CanCollide end
			if thing.CanCollide then thing.CanCollide = false end
		end
	end)
	table1.noclipremovingconnection = character.DescendantRemoving:Connect(function(thing)
		table1.noclipdescendantset[thing] = nil
		for index = #table1.noclipdescendants, 1, -1 do
			if table1.noclipdescendants[index] == thing then table.remove(table1.noclipdescendants, index) break end
		end
		table1.nocliporiginal = table1.owncollisionoriginal[thing]
		if table1.nocliporiginal ~= nil and thing.Parent then thing.CanCollide = table1.nocliporiginal end
		table1.owncollisionoriginal[thing] = nil
	end)
	table1.eznoclipenforcing = table1.RunService.Stepped:Connect(function()
		if not table1.noclipp or table1.noclipcharacter ~= character then return end
		for _, thing in ipairs(table1.noclipdescendants) do
			if thing.Parent and thing:IsA("BasePart") and thing.CanCollide then thing.CanCollide = false end
		end
	end)
end

