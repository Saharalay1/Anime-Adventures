							table1.gupdatetebilboardproj(table1.targetplayer, table1.record, table1.camera)
						elseif table1.record.billboard then
							if table1.record.billboard.Enabled then
								table1.record.billboard.Enabled = false
							end
						end
						if table1.record.skeletalActive then
