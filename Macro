table1.syncplaylistselection = function(song, selected)
	if not song then return end
	table1.playlistselectedindex = table.find(table1.selectedsongs, song)
	if selected == true then
		if not table1.playlistselectedindex then table.insert(table1.selectedsongs, song) end
		table1.playlistselectedindex = table.find(table1.selectedsongs, song)
		if not table1.playlistselectedindex then table.insert(table1.selectedsongs, song) end
	elseif selected == false then
		table1.playlistselectedindex = table.find(table1.selectedsongs, song)
		while table1.playlistselectedindex do
			table.remove(table1.selectedsongs, table1.playlistselectedindex)
			table1.playlistselectedindex = table.find(table1.selectedsongs, song)
		end
	else
		if table1.playlistselectedindex then
			table1.syncplaylistselection(song, false)
		else
			table1.syncplaylistselection(song, true)
		end
	end
	return table.find(table1.selectedsongs, song) ~= nil
end
