table1.tpplayerpassesfilters = function(plr)
	if not plr then return false end
	table1.tpisspecific = (table1.tpspecificset[plr.Name] == true) or (table1.tpspecificset[plr.DisplayName] == true)

	-- Singular Target Mode:
	-- 1 = Always Add  → individual selected players are forced IN on top of team filters
	-- 2 = Always Remove → individual selected players are forced OUT of the team-filter result
	-- 0 / other = treat selected list as Always Add (safe default)

	if table1.singulartargetmode == 2 then
		if table1.tpisspecific then
			return false
		end
	elseif table1.tpisspecific then
		-- Always Add (mode 1 or default): force include regardless of team filter
		return true
	end

	-- No individual override → apply team filters only
	if table1.tpisnone == true then
		return false
	end
	if table1.tpfilter.teams and next(table1.tpfilter.teams) ~= nil then
		if plr.Team and table1.tpfilter.teams[plr.Team.Name] then
			return true
		end
		return false
	end
	if table1.tpfilter.team == true then
		if plr.Team and table1.player.Team and plr.Team == table1.player.Team then
			return true
		end
		return false
	end
	if table1.tpfilter.enemies == true then
		if not plr.Team or not table1.player.Team or plr.Team ~= table1.player.Team then
			return true
		end
		return false
	end
	-- All (or no filter flags set) → allow
	return true
end

table1.tponscreencheck = function(plr, root)
	if not table1.cam or not root or not plr or not plr.Character then
		return false, nil, nil
	end
	table1.tprayorigin = table1.cam.CFrame.Position
	table1.tpraydir = root.Position - table1.tprayorigin
	table1.tpraydist = table1.tpraydir.Magnitude
	if table1.tpraydist < 0.001 then
		return false, nil, nil
	end
	table1.tpscreenpos, table1.tponscreen = table1.cam:WorldToViewportPoint(root.Position)
	if not table1.tponscreen or table1.tpscreenpos.Z <= 0 then
		return false, nil, nil
	end
	if table1.tprayparams then
		table1.tprayparams.FilterDescendantsInstances = table1.mychar and {table1.mychar} or {}
		table1.tpray = table1.Workspace:Raycast(table1.tprayorigin, table1.tpraydir, table1.tprayparams)
		if table1.tpray and table1.tpray.Instance and not table1.tpray.Instance:IsDescendantOf(plr.Character) then
			return false, nil, nil
		end
	end
	table1.tpvp = table1.cam.ViewportSize
	table1.tpscreencenter = Vector2.new(table1.tpvp.X * 0.5, table1.tpvp.Y * 0.5)
	table1.tpscreendist = (Vector2.new(table1.tpscreenpos.X, table1.tpscreenpos.Y) - table1.tpscreencenter).Magnitude
	return true, table1.tpraydist, table1.tpscreendist
end

table1.tpgetcandidates = function(doraycast)
	if table1.tpsyncteamfilter then
		table1.tpsyncteamfilter()
	end
	table1.tpcands = {}
	table1.tpspecificset = {}
	for name, _ in pairs(table1.tpindividualselected or {}) do
		table1.tpspecificset[name] = true
	end

	-- Read live team-filter state. Do NOT force "all" when the user chose None.
	table1.tpisnone = table1.tpfilter.none == true
	table1.tphasfilters = (table1.tpfilter.teams and next(table1.tpfilter.teams) ~= nil)
		or table1.tpfilter.all == true
		or table1.tpfilter.team == true
		or table1.tpfilter.enemies == true
	table1.tphasspecific = next(table1.tpindividualselected or {}) ~= nil

	-- Only fall back to "all" when literally nothing is configured (no team mode and no specific teams).
	-- Never override an explicit "None" choice.
	if table1.tpisnone ~= true and table1.tphasfilters ~= true then
		table1.tpfilter.all = true
		table1.tphasfilters = true
	end

	table1.cam = table1.Workspace.CurrentCamera
	table1.mychar = table1.player.Character
	if table1.tprayparams then
		table1.tprayparams.FilterDescendantsInstances = table1.mychar and {table1.mychar} or {}
	end
	table1.tpraycastused = doraycast == true

	for _, plr in ipairs(table1.Players:GetPlayers()) do
		if plr ~= table1.player and plr.Character then
			table1.tproot = plr.Character:FindFirstChild("HumanoidRootPart")
			table1.tphum = plr.Character:FindFirstChildOfClass("Humanoid")
			if table1.tproot and table1.tphum and table1.tphum.Health > 0 then
				table1.tpcamdist = nil
				table1.tpscreendist = nil
				table1.tpok = true
				if doraycast == true then
					-- Require Raycast: only people currently visible + clear LOS from camera
					table1.tpok, table1.tpcamdist, table1.tpscreendist = table1.tponscreencheck(plr, table1.tproot)
					if table1.tpok ~= true then
						table1.tpok = false
					end
				else
					if table1.cam then
						table1.tpcamdist = (table1.tproot.Position - table1.cam.CFrame.Position).Magnitude
						table1.tpscreenpos = table1.cam:WorldToViewportPoint(table1.tproot.Position)
						if table1.tpscreenpos then
							table1.tpvp = table1.cam.ViewportSize
							table1.tpscreendist = (Vector2.new(table1.tpscreenpos.X, table1.tpscreenpos.Y) - Vector2.new(table1.tpvp.X * 0.5, table1.tpvp.Y * 0.5)).Magnitude
						end
					else
						table1.tpcamdist = 0
					end
				end
				-- Filter first (team + singular), then only keep if still ok after ray/on-screen
				if table1.tpok == true and table1.tpplayerpassesfilters(plr) then
					if not table1.tpcamdist then
						if table1.cam then
							table1.tpcamdist = (table1.tproot.Position - table1.cam.CFrame.Position).Magnitude
						else
							table1.tpcamdist = 0
						end
					end
					table.insert(table1.tpcands, {
						player = plr,
						root = table1.tproot,
						hum = table1.tphum,
						camdist = table1.tpcamdist,
						screendist = table1.tpscreendist
					})
				end
			end
		end
	end
	return table1.tpcands
end

table1.tppicktarget = function(cands)
	if not cands or #cands == 0 then return nil end
	table1.tpsel = table1.tpselcurrent or 1
	table1.myroot = table1.player.Character and table1.player.Character:FindFirstChild("HumanoidRootPart")
	table1.mypos = table1.myroot and table1.myroot.Position or Vector3.zero
	table1.cam = table1.Workspace.CurrentCamera
	table1.campos = table1.cam and table1.cam.CFrame.Position or table1.mypos
	if table1.tpsel == 1 then
		return cands[math.random(1, #cands)]
	elseif table1.tpsel == 2 then
		table1.best = nil
		table1.bestd = -1
		for _, c in ipairs(cands) do
			table1.d = c.camdist or (c.root.Position - table1.campos).Magnitude
			if table1.d > table1.bestd then table1.bestd = table1.d table1.best = c end
		end
		return table1.best
	elseif table1.tpsel == 3 then
		table1.best = nil
		table1.bestd = math.huge
		for _, c in ipairs(cands) do
			if c.screendist ~= nil then
				table1.d = c.screendist
			else
				table1.tpscreenpos = table1.cam and table1.cam:WorldToViewportPoint(c.root.Position) or nil
				if table1.tpscreenpos and table1.cam then
					table1.tpvp = table1.cam.ViewportSize
					table1.d = (Vector2.new(table1.tpscreenpos.X, table1.tpscreenpos.Y) - Vector2.new(table1.tpvp.X * 0.5, table1.tpvp.Y * 0.5)).Magnitude
				else
					table1.d = c.camdist or (c.root.Position - table1.campos).Magnitude
				end
			end
			if table1.d < table1.bestd then table1.bestd = table1.d table1.best = c end
		end
		return table1.best
	elseif table1.tpsel == 4 then
		table1.best = nil
		table1.bestd = math.huge
		for _, c in ipairs(cands) do
			table1.d = (c.root.Position - table1.mypos).Magnitude
			if table1.d < table1.bestd then table1.bestd = table1.d table1.best = c end
		end
		return table1.best
	elseif table1.tpsel == 5 then
		table1.friends = {}
		for _, c in ipairs(cands) do
			if table1.isespfriend and table1.isespfriend(c.player) then
				table.insert(table1.friends, c)
			elseif c.player:IsFriendsWith(table1.player.UserId) then
				table.insert(table1.friends, c)
			end
		end
		if #table1.friends == 0 then return nil end
		return table1.friends[math.random(1, #table1.friends)]
	elseif table1.tpsel == 6 then
		table1.best = nil
		table1.besthp = math.huge
		for _, c in ipairs(cands) do
			if c.hum.Health < table1.besthp then table1.besthp = c.hum.Health table1.best = c end
		end
		return table1.best
	elseif table1.tpsel == 7 then
		table1.best = nil
		table1.besthp = -1
		for _, c in ipairs(cands) do
			if c.hum.Health > table1.besthp then table1.besthp = c.hum.Health table1.best = c end
		end
		return table1.best
	end
	return cands[1]
end

table1.tprayparams = RaycastParams.new()
table1.tprayparams.FilterType = Enum.RaycastFilterType.Exclude
table1.tprayparams.IgnoreWater = true

table1.dotp = function()
	table1.mychar = table1.player.Character
	table1.myroot = table1.mychar and table1.mychar:FindFirstChild("HumanoidRootPart")
	if not table1.myroot then return end
	if table1.tprayparams then
		table1.tprayparams.FilterDescendantsInstances = {table1.mychar}
	end
	table1.needray = false
	if table1.tpsettings and table1.tpsettings:GetAttribute("Selected3") == true then
		table1.needray = true
	end
	table1.tpcands = table1.tpgetcandidates(table1.needray)
	if not table1.tpcands or #table1.tpcands == 0 then return end
	table1.tptgt = table1.tppicktarget(table1.tpcands)
	if not table1.tptgt or not table1.tptgt.root then return end
	table1.ox = tonumber(table1.tpoffx and table1.tpoffx.Text) or 0
	table1.oy = tonumber(table1.tpoffy and table1.tpoffy.Text) or 0
	table1.oz = tonumber(table1.tpoffz and table1.tpoffz.Text) or 0
	table1.tgtcf = table1.tptgt.root.CFrame
	table1.offworld = table1.tgtcf.RightVector * table1.ox + table1.tgtcf.UpVector * table1.oy + table1.tgtcf.LookVector * table1.oz
	table1.newpos = table1.tptgt.root.Position + table1.offworld
	table1.look = table1.tgtcf.LookVector
	if table1.tpsettings and table1.tpsettings:GetAttribute("Selected1") == true then
		table1.look = -table1.look
	end
	table1.myroot.CFrame = CFrame.lookAt(table1.newpos, table1.newpos + table1.look)
	table1.myroot.AssemblyLinearVelocity = Vector3.zero
	table1.myroot.AssemblyAngularVelocity = Vector3.zero
end

table1.dodtp = function()
	table1.mychar = table1.player.Character
	table1.myroot = table1.mychar and table1.mychar:FindFirstChild("HumanoidRootPart")
	if not table1.myroot then return end
	table1.cam = table1.Workspace.CurrentCamera
	table1.dist = tonumber(table1.dtpdistance.Text) or 10
	if table1.dtpsettings:GetAttribute("Selected8") == true and table1.cam then
		table1.dtplook = table1.cam.CFrame.LookVector
		table1.dtpright = table1.cam.CFrame.RightVector
		table1.dtpup = table1.cam.CFrame.UpVector
	else
		table1.dtpcf = table1.myroot.CFrame
		table1.dtplook = table1.dtpcf.LookVector
		table1.dtpright = table1.dtpcf.RightVector
		table1.dtpup = table1.dtpcf.UpVector
	end
	table1.dir = Vector3.zero
	if table1.dtpsettings:GetAttribute("Selected2") == true then table1.dir += table1.dtplook end
	if table1.dtpsettings:GetAttribute("Selected3") == true then table1.dir -= table1.dtplook end
	if table1.dtpsettings:GetAttribute("Selected4") == true then table1.dir -= table1.dtpright end
	if table1.dtpsettings:GetAttribute("Selected5") == true then table1.dir += table1.dtpright end
	if table1.dtpsettings:GetAttribute("Selected6") == true then table1.dir += table1.dtpup end
	if table1.dtpsettings:GetAttribute("Selected7") == true then table1.dir -= table1.dtpup end
	if table1.dir.Magnitude < 0.001 then
		table1.dir = table1.dtplook
	else
		table1.dir = table1.dir.Unit
	end
	table1.newpos = table1.myroot.Position + table1.dir * table1.dist
	table1.myroot.CFrame = CFrame.new(table1.newpos) * (table1.myroot.CFrame - table1.myroot.CFrame.Position)
	table1.myroot.AssemblyLinearVelocity = Vector3.zero
end

table1.dovel = function()
	table1.mychar = table1.player.Character
	table1.myroot = table1.mychar and table1.mychar:FindFirstChild("HumanoidRootPart")
	if not table1.myroot then return end
	table1.velparts = {table1.myroot}
	if table1.velrootcurrent == 2 or table1.velrootcurrent == 3 then
		table1.velhum = table1.mychar:FindFirstChildOfClass("Humanoid")
		if table1.velhum and table1.velhum.SeatPart then
			table1.velseat = table1.velhum.SeatPart
			table1.velveh = table1.velseat:FindFirstAncestorOfClass("Model") or table1.velseat.Parent
			if table1.velrootcurrent == 2 then
				table1.velparts = {(table1.velveh and (table1.velveh.PrimaryPart or table1.velveh:FindFirstChildWhichIsA("BasePart"))) or table1.velseat}
			else
				table1.velparts = {}
				if table1.velveh then
					for _, p in ipairs(table1.velveh:GetDescendants()) do
						if p:IsA("BasePart") then
							table.insert(table1.velparts, p)
						end
					end
				end
				if #table1.velparts == 0 then
					table1.velparts = {table1.velseat}
				end
			end
		end
	end
	table1.cam = table1.Workspace.CurrentCamera
	table1.amt = tonumber(table1.velamount.Text) or 150
	if table1.velsettings:GetAttribute("Selected9") == true and table1.cam then
		table1.vrelcf = table1.cam.CFrame
	else
		table1.vrelcf = table1.myroot.CFrame
	end
	table1.vlook = table1.vrelcf.LookVector
	table1.vright = table1.vrelcf.RightVector
	table1.vup = table1.vrelcf.UpVector
	table1.vdir = Vector3.zero
	if table1.velsettings:GetAttribute("Selected1") == true then table1.vdir += table1.vlook end
	if table1.velsettings:GetAttribute("Selected2") == true then table1.vdir -= table1.vlook end
	if table1.velsettings:GetAttribute("Selected3") == true then table1.vdir -= table1.vright end
	if table1.velsettings:GetAttribute("Selected4") == true then table1.vdir += table1.vright end
	if table1.velsettings:GetAttribute("Selected5") == true then table1.vdir += table1.vup end
	if table1.velsettings:GetAttribute("Selected6") == true then table1.vdir -= table1.vup end
	if table1.vdir.Magnitude < 0.001 then
		table1.vdir = table1.vlook
	else
		table1.vdir = table1.vdir.Unit
	end
	table1.velax = tonumber(table1.vellxxa and table1.vellxxa.Text) or 0
	table1.velay = tonumber(table1.vellyya and table1.vellyya.Text) or 0
	table1.velaz = tonumber(table1.vellzza and table1.vellzza.Text) or 0
	if table1.velax ~= 0 or table1.velay ~= 0 or table1.velaz ~= 0 then
		if table1.velay ~= 0 then
			table1.vdir = CFrame.fromAxisAngle(table1.vright, math.rad(table1.velay)) * table1.vdir
		end
		if table1.velax ~= 0 then
			table1.vdir = CFrame.fromAxisAngle(table1.vup, math.rad(table1.velax)) * table1.vdir
		end
		if table1.velaz ~= 0 then
			table1.vdir = CFrame.fromAxisAngle(table1.vlook, math.rad(table1.velaz)) * table1.vdir
		end
		if table1.vdir.Magnitude > 0.001 then
			table1.vdir = table1.vdir.Unit
		else
			table1.vdir = table1.vlook
		end
	end
	table1.vdelta = table1.vdir * table1.amt
	table1.velox = tonumber(table1.vellxx and table1.vellxx.Text) or 0
	table1.veloy = tonumber(table1.vellyy and table1.vellyy.Text) or 0
	table1.veloz = tonumber(table1.vellzz and table1.vellzz.Text) or 0
	table1.veloffworld = table1.vrelcf:VectorToWorldSpace(Vector3.new(table1.velox, table1.veloy, table1.veloz))
	table1.velang = Vector3.zero
	if table1.veloffworld.Magnitude > 0.001 then
		table1.velang = table1.veloffworld:Cross(table1.vdir)
	end
	table1.isset = table1.velsettings:GetAttribute("Selected8") == true
	table1.vmode = table1.velmodecurrent or 2
	table1.veli = 1
	while table1.veli <= #table1.velparts do
		table1.velpart = table1.velparts[table1.veli]
		if table1.isset then
			table1.velpart.AssemblyLinearVelocity = table1.vdelta
			if table1.velang.Magnitude > 0.001 then
				table1.velpart.AssemblyAngularVelocity = table1.velang
			end
		else
			table1.velpart.AssemblyLinearVelocity = table1.velpart.AssemblyLinearVelocity + table1.vdelta
			if table1.velang.Magnitude > 0.001 then
				table1.velpart.AssemblyAngularVelocity = table1.velpart.AssemblyAngularVelocity + table1.velang
			end
		end
		table1.veli += 1
	end
end

