table1.settargettcharacter = function(targetPlayer, character)
	local record = table1.espplayerrecords[targetPlayer]
	if not record then return end
	if character and targetPlayer.Character ~= character then return end
	-- cancel any in-flight attach for this record
	record.attachToken = (record.attachToken or 0) + 1
	local token = record.attachToken
	table1.cleanuppppcharacterconnectionssss(record)
	table1.dsstroybillboardssstuffsfsfsfsf(record)
	table1.d3boxgonbro(record)
	table1.destroytracerstuff(targetPlayer)
	record.skeletalParts = nil
	record.skeletalPartsCharacter = nil
	record.skeletalActive = false
	record.skeletalBonesActive = false
	record.root = nil
	record.humanoid = nil
	record.bodyParts = {}
	if not character or not character.Parent then
		record.character = nil
		if table1.updateskeletalforplayer then
			table1.updateskeletalforplayer(targetPlayer, record, table1.Workspace.CurrentCamera)
		end
		table1.esplistdirty = true
		table1.refreshESPRenderConnection()
		return
	end
	-- hold character only after we confirm parts; until then keep nil so playess does not draw dead state
	record.character = nil
	task.spawn(function()
		local root = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not root then
			root = character:WaitForChild("HumanoidRootPart", 8)
		end
		if not humanoid then
			humanoid = character:WaitForChild("Humanoid", 8)
		end
		-- aborted / superseded / player left / character replaced
		if token ~= record.attachToken then return end
		if not root or not humanoid then return end
		if targetPlayer.Parent ~= table1.Players then return end
		if targetPlayer.Character ~= character or not character.Parent then return end
		if table1.espplayerrecords[targetPlayer] ~= record then return end
		record.character = character
		record.root = root
		record.humanoid = humanoid
		table1.rebuilddbodypartss(record)
		record.box3DFixedSize = nil
		record.box3DFixedCenter = nil
		local minBounds, maxBounds = table1.boundybodyget(record)
		if minBounds then
			record.box3DFixedSize = maxBounds - minBounds
			record.box3DFixedCenter = (minBounds + maxBounds) * 0.5
		else
			record.box3DFixedSize = Vector3.new(2, 5, 1)
			record.box3DFixedCenter = Vector3.new(0, 0, 0)
		end
		table.insert(record.characterConnections, character.DescendantAdded:Connect(function(descendant)
			if record.character == character and table1.isssboddyyyyparttt(character, descendant) then
				record.skeletalParts = nil
				table.insert(record.bodyParts, descendant)
				table1.playesspppppupdaateee(targetPlayer, record)
			end
		end))
		table.insert(record.characterConnections, character.DescendantRemoving:Connect(function(descendant)
			record.skeletalParts = nil
			for index = #record.bodyParts, 1, -1 do
				if record.bodyParts[index] == descendant then table.remove(record.bodyParts, index) end
			end
			task.defer(function()
				if table1.espplayerrecords[targetPlayer] == record and record.character == character then
					table1.playesspppppupdaateee(targetPlayer, record)
				end
			end)
		end))
		table.insert(record.characterConnections, humanoid.HealthChanged:Connect(function()
			if table1.infographicoptions[2] then table1.playesspppppupdaateee(targetPlayer, record) end
		end))
		table.insert(record.characterConnections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
			if table1.infographicoptions[2] then table1.playesspppppupdaateee(targetPlayer, record) end
		end))
		table.insert(record.characterConnections, humanoid.Died:Connect(function()
			-- visuals stay until CharacterRemoving; mark dirty so render drops this frame cleanly
			table1.esplistdirty = true
			table1.refreshESPRenderConnection()
		end))
		if token ~= record.attachToken then return end
		table1.playesspppppupdaateee(targetPlayer, record)
		if table1.updateskeletalforplayer then
			table1.updateskeletalforplayer(targetPlayer, record, table1.Workspace.CurrentCamera)
		end
		if table1.updatechamsforplayer then
			table1.updatechamsforplayer(targetPlayer)
		end
		table1.esplistdirty = true
		table1.refreshESPRenderConnection()
	end)
end

table1.connectespplayer = function(targetPlayer)
	if not targetPlayer or targetPlayer == table1.player then return end
	local record = table1.espplayerrecords[targetPlayer]
	if record then
		local connected = #(record.playerConnections or {}) > 0
		for _, connection in ipairs(record.playerConnections or {}) do
			if not connection.Connected then connected = false break end
		end
		if connected then
			-- hooks live: only reattach current character for THIS player
			local char = targetPlayer.Character
			if char and char.Parent then
				if record.character ~= char or not record.root or not record.root.Parent or not record.humanoid or not record.humanoid.Parent then
					table1.settargettcharacter(targetPlayer, char)
				else
					table1.playesspppppupdaateee(targetPlayer, record)
					if table1.updateskeletalforplayer then
						table1.updateskeletalforplayer(targetPlayer, record, table1.Workspace.CurrentCamera)
					end
					if table1.updatechamsforplayer then
						table1.updatechamsforplayer(targetPlayer)
					end
				end
			elseif record.character then
				table1.settargettcharacter(targetPlayer, nil)
			else
				table1.playesspppppupdaateee(targetPlayer, record)
			end
			return
		end
		table1.removeconnections(record.playerConnections)
		table1.cleanuppppcharacterconnectionssss(record)
		table1.dsstroybillboardssstuffsfsfsfsf(record)
		table1.d3boxgonbro(record)
		table1.destroytracerstuff(targetPlayer)
	else
		record = {}
	end
	record.playerConnections = {}
	record.characterConnections = record.characterConnections or {}
	record.bodyParts = record.bodyParts or {}
	record.attachToken = record.attachToken or 0
	table1.espplayerrecords[targetPlayer] = record
	table.insert(record.playerConnections, targetPlayer:GetPropertyChangedSignal("Team"):Connect(function()
		table1.espfriendcache[targetPlayer.UserId] = nil
		if targetPlayer.Parent == table1.Players and table1.espplayerrecords[targetPlayer] == record then
			-- team change only re-evaluates THIS player
			table1.playesspppppupdaateee(targetPlayer, record)
			if table1.updatechamsforplayer then table1.updatechamsforplayer(targetPlayer) end
			if table1.updateskeletalforplayer then
				table1.updateskeletalforplayer(targetPlayer, record, table1.Workspace.CurrentCamera)
			end
			table1.esplistdirty = true
			table1.refreshESPRenderConnection()
		end
	end))
	table.insert(record.playerConnections, targetPlayer.CharacterAdded:Connect(function(character)
		-- respawn / rejoin character: reattach ESP for THIS player only
		task.defer(function()
			if targetPlayer.Parent ~= table1.Players then return end
			if targetPlayer.Character ~= character then return end
			if table1.espplayerrecords[targetPlayer] ~= record then return end
			table1.settargettcharacter(targetPlayer, character)
		end)
	end))
	table.insert(record.playerConnections, targetPlayer.CharacterRemoving:Connect(function(character)
		if record.character == character then
			table1.settargettcharacter(targetPlayer, nil)
		end
	end))
	if targetPlayer.Character and targetPlayer.Character.Parent then
		task.defer(function()
			if targetPlayer.Parent == table1.Players and table1.espplayerrecords[targetPlayer] == record then
				table1.settargettcharacter(targetPlayer, targetPlayer.Character)
			end
		end)
	else
		table1.playesspppppupdaateee(targetPlayer, record)
	end
end

table1.disconnectespplayer = function(targetPlayer)
	local record = table1.espplayerrecords[targetPlayer]
	if record then
		table1.removeconnections(record.playerConnections)
