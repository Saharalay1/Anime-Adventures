		return
	end
	local outlineColor = table1.getesptargetcolor(targetPlayer, table1.getespcolor(table1.b3boxxespcolor, table1.white, table1.esp3dcolorvalues))
	local fillColor = table1.getesptargetcolor(targetPlayer, table1.getespcolor(table1.b3boxxespfillcolor, table1.purple, table1.esp3dcolorvalues))
	local outlineTransparency = table1.getesptransparency(table1.b3boxxesptransparency, 0)
