table1.gupdatetebilboardproj = function(targetPlayer, record, camera)
	if not record or not record.billboard or not record.root or not record.humanoid or record.humanoid.Health <= 0 then
		if record and record.billboard then record.billboard.Enabled = false end
		return
	end
	camera = camera or table1.Workspace.CurrentCamera
	local minX, minY, maxX, maxY = table1.screembodybounds(record, camera)
	if not minX then
		record.billboard.Enabled = false
		return
	end
	local left, top, right, bottom = minX, minY, maxX, maxY
	local boxWidth = math.max(2, right - left)
	local boxHeight = math.max(2, bottom - top)
	local centerX = (left + right) * 0.5
	if table1.infographic then
		table1.infopti = 1
		while table1.infopti <= 11 do
			table1.infographicoptions[table1.infopti] = table1.infographic:GetAttribute("Selected" .. table1.infopti) == true
			table1.infopti += 1
		end
	end
	local options = table1.infographicoptions
	local showBox = record.show2D == true
	local showInfo = record.showInfo == true
	local sizeScale = table1.getinfographicscale()
	local textSize = math.clamp(math.floor(14 * sizeScale + 0.5), 8, 48)
	local textHeight = math.max(10, math.ceil(textSize + 2))
	local barScale = table1.gethealthbarscale()
	local baseBar = math.max(2, math.min(boxWidth, boxHeight) * 0.06)
	local barThickness = math.clamp(baseBar * barScale, 2, 16)
	local gap = math.max(1, math.floor(textSize * 0.032 + 0.5))
	local showUsername = showInfo and options[1] == true
	local showDisplay = showInfo and options[2] == true
	local showHealth = showInfo and options[3] == true
	local showDistance = showInfo and options[4] == true
	local barMode = showHealth and options[7] == true
	local barLeft = options[8] == true
	local barRight = options[9] == true
	local barLocation = "Top"
	if barLeft and barRight then
		barLocation = "Bottom"
	elseif barLeft then
		barLocation = "Left"
	elseif barRight then
		barLocation = "Right"
	end
	local ratio = 0
	if record.humanoid.MaxHealth > 0 then
		ratio = math.clamp(record.humanoid.Health / record.humanoid.MaxHealth, 0, 1)
	end
	local healthColor = table1.gethealthcolor(ratio)
	local healthText = options[11] and (tostring(math.floor(ratio * 100 + 0.5)) .. "%") or tostring(math.floor(record.humanoid.Health + 0.5))
	local healthTextColor = options[10] and (record.infoTextColor or table1.white) or healthColor
	local cursorY = top
	local healthTextY
	local barX, barY, barWidth, barHeight
	if barMode then
		if barLocation == "Top" then
			barX, barY, barWidth, barHeight = left, top - gap - barThickness, boxWidth, barThickness
			cursorY = barY
		elseif barLocation == "Bottom" then
			barX, barY, barWidth, barHeight = left, bottom + gap, boxWidth, barThickness
		elseif barLocation == "Left" then
			barX, barY, barWidth, barHeight = left - gap - barThickness, top, barThickness, boxHeight
		else
			barX, barY, barWidth, barHeight = right + gap, top, barThickness, boxHeight
		end
	elseif showHealth then
		healthTextY = cursorY - gap - textHeight
		cursorY = healthTextY
	end
	local distanceY
	if showDistance then
		distanceY = cursorY - gap - textHeight
		cursorY = distanceY
	end
	local displayY
	if showDisplay then
		displayY = cursorY - gap - textHeight
		cursorY = displayY
	end
	local nameY
	if showUsername then
		nameY = cursorY - gap - textHeight
		cursorY = nameY
	end
	local labelWidth = math.max(80, boxWidth + 16)
	local extentX = centerX
	local useTextOutline = options[5] == true
	local outlineColor = record.infoOutlineColor or Color3.fromRGB(0, 0, 0)
