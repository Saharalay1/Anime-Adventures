		if table1.playerclipcharacterremovingconnections[player] then table1.playerclipcharacterremovingconnections[player]:Disconnect() table1.playerclipcharacterremovingconnections[player] = nil end
		if table1.playerclipdescendantconnections[player] then table1.playerclipdescendantconnections[player]:Disconnect() table1.playerclipdescendantconnections[player] = nil end
