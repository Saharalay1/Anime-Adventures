table1.refreshESPRenderConnection = function()
	if table1.esprenderconnection and not table1.esprenderconnection.Connected then
		table1.esprenderconnection = nil
	end
	if table1.esplistdirty then
		table1.buildespactivelist()
	end
	table1.needsrender = #table1.espactivelist > 0
	if table1.needsrender and not table1.esprenderconnection then
		table1.esprenderconnection = table1.RunService.RenderStepped:Connect(function()
			if not table1.areyoufuckingabletouseesp then
				return
			end
			table1.camera = table1.Workspace.CurrentCamera
			if not table1.camera then
				return
			end
			table1.viewport = table1.camera.ViewportSize
			if table1.esprendercache.viewportx ~= table1.viewport.X or table1.esprendercache.viewporty ~= table1.viewport.Y then
				table1.esprendercache.viewportx = table1.viewport.X
				table1.esprendercache.viewporty = table1.viewport.Y
				table1.esprendercache.originy = 8
				if table1.esprendercache.tracermode == 3 then
					table1.esprendercache.originy = table1.viewport.Y * 0.5
				elseif table1.esprendercache.tracermode == 4 then
					table1.esprendercache.originy = table1.viewport.Y - 8
				end
			end
			table1.esptracerorigin = Vector2.new(table1.viewport.X * 0.5, table1.esprendercache.originy)
			if table1.esplistdirty then
				table1.buildespactivelist()
			end
			for i = 1, #table1.espactivelist do
				table1.targetplayer = table1.espactivelist[i]
				table1.record = table1.espplayerrecords[table1.targetplayer]
				if not table1.record or not table1.targetplayer.Parent or not table1.record.root or not table1.record.root.Parent then
					table1.esplistdirty = true
				else
					table1.espinfrustum = table1.isinfrustum(table1.record.root.Position, table1.camera, 120)
