	if table1.dtploopconn then table1.dtploopconn:Disconnect() table1.dtploopconn = nil end
	table1.velloopactive = false
	if table1.velloopconn then table1.velloopconn:Disconnect() table1.velloopconn = nil end
	if table1.tpsettings then table1.tpflashaction(table1.tpsettings, false) end
	if table1.dtpsettings then table1.tpflashaction(table1.dtpsettings, false) end
	if table1.velsettings then table1.tpflashaction(table1.velsettings, false) end
