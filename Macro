	end
	table1.rig3don = table1.b3boxxesp and table1.b3boxxesp:GetAttribute("Mode") == 1
	if table1.rig3don then
		local boxSize, boxLocalCF = table1.computemodelbounds(table1.rigmodel, table1.righrp)
