	highlight.FillColor = table1.chamsselectedcolor or fillColor
	highlight.OutlineColor = outlineEnabled and (table1.chamsselectedcolor or outlineColor) or outlineColor
	highlight.FillTransparency = fillEnabled and table1.getesptransparency(table1.chamsfilltransparency, 0.75) or 1
	if outlineEnabled then
		highlight.OutlineTransparency = table1.getesptransparency(table1.chamsoutlinetransparency, 0)
