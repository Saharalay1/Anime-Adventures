		end
		if table1.hitboxmaster and table1.updatehitboxes then table1.updatehitboxes() end
	end)
end

table1.bindplayerlifecycle = function(p)
	if not p or p == table1.player then return end
	if table1.playerlifecycleconns[p] then
		for _, c in ipairs(table1.playerlifecycleconns[p]) do
			if c then c:Disconnect() end
		end
		table1.playerlifecycleconns[p] = nil
	end
	table1.playerlifecycleconns[p] = {}
	if table1.updateplayercache then table1.updateplayercache(p) end
	table.insert(table1.playerlifecycleconns[p], p.CharacterAdded:Connect(function(character)
		task.defer(function()
			if p.Parent ~= table1.Players then return end
			if table1.updateplayercache then table1.updateplayercache(p) end
			table1.bindplayerhumanoidlifecycle(p, character)
			table1.esplistdirty = true
			if table1.areyoufuckingabletouseesp then
				-- only this player: ensure hooks + reattach character
				if table1.connectespplayer then table1.connectespplayer(p) end
				if table1.connectchamsplayer then table1.connectchamsplayer(p) end
				if table1.espplayerrecords and table1.espplayerrecords[p] and table1.settargettcharacter then
					table1.settargettcharacter(p, character)
				end
				if table1.updatechamsforplayer then table1.updatechamsforplayer(p) end
				if table1.refreshESPRenderConnection then table1.refreshESPRenderConnection() end
			end
			if table1.hitboxmaster and table1.updatehitboxes then
				task.wait(0.1)
				table1.updatehitboxes()
			end
		end)
	end))
	table.insert(table1.playerlifecycleconns[p], p.CharacterRemoving:Connect(function(character)
		if table1.playerlifecyclehumconns[p] then
			table1.playerlifecyclehumconns[p]:Disconnect()
			table1.playerlifecyclehumconns[p] = nil
		end
		if table1.updateplayercache then table1.updateplayercache(p) end
		table1.esplistdirty = true
		if table1.areyoufuckingabletouseesp then
			if table1.espplayerrecords and table1.espplayerrecords[p] and table1.settargettcharacter then
				if table1.espplayerrecords[p].character == character then
					table1.settargettcharacter(p, nil)
				end
			end
			if table1.updatechamsforplayer then table1.updatechamsforplayer(p) end
			if table1.refreshESPRenderConnection then table1.refreshESPRenderConnection() end
		end
		if table1.hitboxmaster and table1.updatehitboxes then table1.updatehitboxes() end
	end))
	table.insert(table1.playerlifecycleconns[p], p:GetPropertyChangedSignal("Team"):Connect(function()
		if table1.updateplayercache then table1.updateplayercache(p) end
		table1.espfriendcache[p.UserId] = nil
		table1.esplistdirty = true
		if table1.areyoufuckingabletouseesp then
			-- team change: only this player
			if table1.espplayerrecords and table1.espplayerrecords[p] and table1.playesspppppupdaateee then
				table1.playesspppppupdaateee(p, table1.espplayerrecords[p])
			end
			if table1.updatechamsforplayer then table1.updatechamsforplayer(p) end
			if table1.refreshESPRenderConnection then table1.refreshESPRenderConnection() end
		end
		if table1.hitboxmaster and table1.updatehitboxes then table1.updatehitboxes() end
	end))
	if p.Character then
		table1.bindplayerhumanoidlifecycle(p, p.Character)
	end
end

