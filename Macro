table1.tptrigger = function()
	table1.tpst = table1.maintoggleState[table1.tpsettings]
	table1.tphold = table1.tpst and table1.tpst.actionhold == "hold"
	table1.tploop = table1.tpsettings:GetAttribute("Selected2") == true
	if table1.tphold then
		table1.tpact = table1.tpsettings:GetAttribute("ActionActive") == true
		if table1.tpact then
			if not table1.tploopactive then
				table1.tpstarthloop()
			end
		else
			table1.tpstoptloop()
		end
	else
		if table1.tploop then
			if table1.tploopactive then
				table1.tpstoptloop()
			else
				table1.tpstarthloop()
			end
		else
			table1.dotp()
			table1.tpflashaction(table1.tpsettings, true)
			task.delay(0.12, function()
				if not table1.tploopactive then
					table1.tpflashaction(table1.tpsettings, false)
				end
			end)
		end
	end
end

table1.dtptrigger = function()
	table1.dtpst = table1.maintoggleState[table1.dtpsettings]
	table1.dtphold = table1.dtpst and table1.dtpst.actionhold == "hold"
	table1.dtploop = table1.dtpsettings:GetAttribute("Selected1") == true
	if table1.dtphold then
		table1.dtpact = table1.dtpsettings:GetAttribute("ActionActive") == true
		if table1.dtpact then
			if not table1.dtploopactive then
				table1.dtpstarthloop()
			end
		else
			table1.dtpstoptloop()
		end
	else
		if table1.dtploop then
			if table1.dtploopactive then
				table1.dtpstoptloop()
			else
				table1.dtpstarthloop()
