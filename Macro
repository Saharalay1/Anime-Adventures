	if table1.pcascale > 3 then table1.pcascale = 3 end
	if not table1.pcactionsorder then table1.pcactionsorder = {} end
	table1.pcseen = {}
	for _,main in ipairs(table1.pcactionsorder) do
		table1.abstate = table1.maintoggleState[main]
